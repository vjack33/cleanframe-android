import "./assets/fonts/Geist-Variable.ttf";
import "./assets/fonts/Newsreader-Variable.ttf";

export struct AppItem {
    id: string,
    name: string,
    pkg: string,
    icon: image,
}

export struct HdmiItem {
    id: string,
    label: string,
    connected: bool,
}

export struct SettingItem {
    id: string,
    label: string,
    value: string,
}

export struct DetailOption {
    id: string,
    title: string,
    desc: string,
    active: bool,
}

component LiquidGlassPanel inherits Rectangle {
    in property <image> frost_image;
    in property <length> scene_width: 960px;
    in property <length> scene_height: 540px;
    in property <length> origin_x: 0px;
    in property <length> origin_y: 0px;
    in property <brush> glass_tint: @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.07) 32%, rgba(18, 24, 32, 0.28) 72%, rgba(12, 16, 22, 0.45) 100%);
    in property <color> rim_color: rgba(255, 255, 255, 0.35);
    in property <length> rim_width: 1.2px;
    in property <bool> show_specular_hairline: true;
    in property <bool> show_left_rim: false;

    // Drop shadow separating optical glass from wallpaper
    drop-shadow-offset-y: 10px;
    drop-shadow-blur: 24px;
    drop-shadow-color: rgba(0, 0, 0, 0.38);

    // Inner Clipped Optical Glass Substrate
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        clip: true;

        // 1:1 Co-located blurred wallpaper computed dynamically at runtime
        Image {
            x: -root.origin_x;
            y: -root.origin_y;
            width: root.scene_width;
            height: root.scene_height;
            image-fit: cover;
            source: root.frost_image;
        }

        // Luminous Glass Body Tint & Perimeter Rim
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: root.border-radius;
            background: root.glass_tint;
            border-width: root.rim_width;
            border-color: root.rim_color;
        }

        // Top Specular Hairline (Overhead light catch)
        if root.show_specular_hairline: Rectangle {
            x: 20px;
            y: 1px;
            width: parent.width - 40px;
            height: 1.25px;
            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.50) 20%, rgba(255, 255, 255, 0.88) 50%, rgba(255, 255, 255, 0.50) 80%, rgba(255, 255, 255, 0.0) 100%);
        }

        // Left Specular Rim (Directional light sweep)
        if root.show_left_rim: Rectangle {
            x: 1px;
            y: 16px;
            width: 1px;
            height: parent.height - 32px;
            background: @linear-gradient(180deg, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0.08) 100%);
        }

        // Bottom subtle edge burn
        Rectangle {
            x: 32px;
            y: parent.height - 2px;
            width: parent.width - 64px;
            height: 1px;
            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.0) 100%);
        }
    }
}

export component MainWindow inherits Window {
    width: 960px;
    height: 540px;
    default-font-family: (root.current_font == "Newsreader") ? "Newsreader" :
                         (root.current_font == "Geist") ? "Geist" : "sans-serif";

    // Appearance State Properties
    in property <string> clock_text: "1:54";
    in property <string> focused_caption: "Prime Video";
    in property <int> wallpaper_idx: 3; // 0..14 (All 15 Curated Photographic Wallpapers)
    in property <string> current_layout: "List"; // "List" | "Dock"
    in property <string> current_font: "Manrope"; // "Manrope" | "Newsreader" | "Geist"
    in property <string> current_material: "Frost"; // "Frost" | "Soft" | "Clear tint"
    in property <string> current_focus_style: "Glass, Soft"; // "Glass, Soft" | "Minimal Pill"
    in property <string> current_icon_pack: "CleanFrame default"; // "CleanFrame default" | "Full Color"
    in property <image> dynamic_frost_image;

    // Primary Home Apps (8 Apps)
    in property <[AppItem]> apps: [
        { id: "youtube", name: "SmartTube", pkg: "org.smarttube.stable", icon: @image-url("assets/icons/youtube.svg") },
        { id: "spotify", name: "Spotify", pkg: "com.spotify.tv.android", icon: @image-url("assets/icons/spotify.svg") },
        { id: "appletv", name: "Apple TV", pkg: "com.apple.atve.androidtv.appletv", icon: @image-url("assets/icons/appletv.svg") },
        { id: "primevideo", name: "Prime Video", pkg: "com.amazon.amazonvideo.livingroom", icon: @image-url("assets/icons/primevideo.svg") },
        { id: "netflix", name: "Netflix", pkg: "com.netflix.ninja", icon: @image-url("assets/icons/netflix.svg") },
        { id: "aurora", name: "Aurora Store", pkg: "com.aurora.store", icon: @image-url("assets/icons/aurora.svg") },
        { id: "projectivy", name: "Projectivy Launcher", pkg: "com.spocky.projengmenu", icon: @image-url("assets/icons/projectivy.svg") },
        { id: "settings", name: "Settings", pkg: "android.settings.SETTINGS", icon: @image-url("assets/icons/settings.svg") }
    ];
    in property <int> selected_app: 3;

    // HDMI Inputs Shelf
    in property <[HdmiItem]> inputs: [
        { id: "hw1", label: "HDMI 1 · Mac", connected: true },
        { id: "hw2", label: "HDMI 2", connected: false },
        { id: "hw3", label: "HDMI 3", connected: true },
        { id: "av", label: "AV", connected: false }
    ];
    in property <int> selected_input: 0;

    // Utilities Shelf: 4 Controls
    in property <[string]> utils: ["Art Mode", "All apps", "Inputs", "Settings"];
    in property <int> selected_util: 0;

    // Active Navigation Zone: "apps" | "inputs" | "util" | "media"
    in property <string> active_zone: "apps";

    // Now Playing State (Default false, matches webview on TV when no media active)
    in property <bool> now_playing_visible: false;
    in property <string> now_playing_title: "CleanFrame Ambient";
    in property <string> now_playing_artist: "The Frame Audio";
    in property <bool> now_playing_playing: false;

    // Art Mode State
    in property <bool> art_mode: false;
    in property <string> art_title: "Mountain valley";
    in property <string> art_artist: "Aniket Deole · Unsplash";
    in property <bool> art_saved_notice: false;

    // Settings Navigation State
    in property <bool> settings_open: false;
    in property <bool> settings_detail: false;
    in property <string> detail_title: "Background";
    in property <string> detail_desc: "Choose a photographic background or solid color.";
    in property <int> selected_setting: 0;
    in property <int> selected_detail_option: 0;

    // 8 Settings Overview Items (Matching Webview Version Exactly)
    in property <[SettingItem]> settings_list: [
        { id: "background", label: "Background", value: "Mountain valley" },
        { id: "layout", label: "Layout", value: "List" },
        { id: "typography", label: "Typography", value: "Manrope" },
        { id: "icons", label: "Icon pack", value: "CleanFrame default" },
        { id: "focus", label: "Focus", value: "Glass, Soft" },
        { id: "inputs", label: "TV inputs", value: "Device dependent" },
        { id: "editor", label: "Apps on Home", value: "8 apps" },
        { id: "samsung", label: "Samsung", value: "Home and TV settings" }
    ];

    in property <[DetailOption]> detail_options: [];

    // Callbacks to Rust Controller
    callback key_up();
    callback key_down();
    callback key_left();
    callback key_right();
    callback key_ok();
    callback key_back();

    // 1. DYNAMIC PHOTOGRAPHIC WALLPAPER (All 15 Curated Artworks)
    Image {
        width: 100%;
        height: 100%;
        source: (root.wallpaper_idx == 0) ? @image-url("assets/wallpapers/misty.jpg") :
                (root.wallpaper_idx == 1) ? @image-url("assets/wallpapers/cove.jpg") :
                (root.wallpaper_idx == 2) ? @image-url("assets/wallpapers/forest.jpg") :
                (root.wallpaper_idx == 3) ? @image-url("assets/wallpapers/valley.jpg") :
                (root.wallpaper_idx == 4) ? @image-url("assets/wallpapers/night.jpg") :
                (root.wallpaper_idx == 5) ? @image-url("assets/wallpapers/peaks.jpg") :
                (root.wallpaper_idx == 6) ? @image-url("assets/wallpapers/bridge.jpg") :
                (root.wallpaper_idx == 7) ? @image-url("assets/wallpapers/ridge.jpg") :
                (root.wallpaper_idx == 8) ? @image-url("assets/wallpapers/golden.jpg") :
                (root.wallpaper_idx == 9) ? @image-url("assets/wallpapers/summit.jpg") :
                (root.wallpaper_idx == 10) ? @image-url("assets/wallpapers/goldcoast.jpg") :
                (root.wallpaper_idx == 11) ? @image-url("assets/wallpapers/sydney.jpg") :
                (root.wallpaper_idx == 12) ? @image-url("assets/wallpapers/amber.jpg") :
                (root.wallpaper_idx == 13) ? @image-url("assets/wallpapers/mint.jpg") :
                @image-url("assets/wallpapers/alpine.jpg");
        image-fit: cover;
    }

    // Material Scrim Overlays (Clean separate top shade and bottom scrim)
    // Preserves wallpaper clarity in the center matching webview .shade and .scrim
    if !root.art_mode: Rectangle {
        width: 100%;
        height: 100%;

        // Top shade for clock and utilities legibility
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 150px;
            background: @linear-gradient(180deg, rgba(4, 10, 12, 0.30) 0%, rgba(4, 10, 12, 0.10) 65%, rgba(4, 10, 12, 0.0) 100%);
        }

        // Bottom scrim for dock and HDMI legibility
        Rectangle {
            x: 0px;
            y: 280px;
            width: 100%;
            height: 260px;
            background: @linear-gradient(180deg, rgba(4, 10, 12, 0.0) 0%, rgba(4, 10, 12, 0.12) 50%, rgba(4, 10, 12, 0.32) 100%);
        }
    }

    // 2. CLOCK & FOCUSED ITEM CAPTION
    // In DOCK layout: positioned at Top-Left (matching real_tv_webview_restored.png)
    // In LIST layout: positioned at Top-Right (matching list layout design)
    if (!root.settings_open && !root.art_mode): Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 36px;
            text: root.clock_text;
            font-size: 46px;
            font-weight: 500;
            color: #f6f1e7;
        }

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 92px;
            text: root.focused_caption;
            font-size: 19px;
            font-weight: 500;
            color: rgba(246, 241, 231, 0.90);
        }
    }

    // 3. HOME ELEMENTS (Hidden in Art Mode & Settings)
    if (!root.settings_open && !root.art_mode): Rectangle {
        width: 100%;
        height: 100%;

        // ==========================================
        // --- LIST LAYOUT (Photographic Typography) ---
        // ==========================================
        if root.current_layout == "List": Rectangle {
            x: 56px;
            y: 74px;
            width: 420px;
            height: 440px;

            for app[i] in root.apps: Rectangle {
                y: i * 52px;
                width: 320px;
                height: 48px;

                // Focus pill (Liquid Frosted Glass Capsule with Specular Highlight)
                if (root.active_zone == "apps" && root.selected_app == i): Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 260px;
                    height: 48px;

                    LiquidGlassPanel {
                        width: 100%;
                        height: 100%;
                        border-radius: 24px;
                        frost_image: root.dynamic_frost_image;
                        origin_x: 56px;
                        origin_y: 74px + i * 52px;
                        glass_tint: (root.current_focus_style == "Minimal Pill") ?
                            rgba(255, 255, 255, 0.28) :
                            @linear-gradient(155deg, rgba(255, 255, 255, 0.45) 0%, rgba(240, 245, 250, 0.22) 48%, rgba(255, 255, 255, 0.35) 100%);
                        rim_color: rgba(255, 255, 255, 0.75);
                        rim_width: 1.2px;
                        show_specular_hairline: (root.current_focus_style == "Glass, Soft");
                        show_left_rim: false;
                    }
                }

                // App Brand Icon
                Image {
                    x: 14px;
                    y: 11px;
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                    source: app.icon;
                    colorize: (root.current_icon_pack == "Full Color") ?
                        #ffffff :
                        ((root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.85));
                }

                // App Name
                Text {
                    x: 52px;
                    y: 9px;
                    text: app.name;
                    font-size: (root.active_zone == "apps" && root.selected_app == i) ? 26px : 24px;
                    font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 700 : 500;
                    color: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.78);
                }
            }
        }

        // ==========================================
        // --- DOCK LAYOUT (Liquid Frosted Glass) ---
        // ==========================================
        // 960x540 geometry: width: 752px, height: 116px, y: 338px
        if root.current_layout == "Dock": Rectangle {
            x: (root.width - 752px) / 2;
            y: 338px;
            width: 752px;
            height: 116px;

            // Liquid Glass Backdrop Mat
            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 26px;
                frost_image: root.dynamic_frost_image;
                origin_x: (root.width - 752px) / 2;
                origin_y: 338px;
                glass_tint: (root.current_material == "Clear tint") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.06) 30%, rgba(18, 24, 32, 0.22) 70%, rgba(10, 14, 20, 0.36) 100%) :
                    (root.current_material == "Soft") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.08) 30%, rgba(24, 30, 38, 0.28) 70%, rgba(14, 18, 24, 0.42) 100%) :
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.07) 30%, rgba(18, 22, 28, 0.25) 70%, rgba(12, 16, 22, 0.40) 100%);
                rim_color: rgba(255, 255, 255, 0.34);
                rim_width: 1.25px;
                show_specular_hairline: true;
                show_left_rim: true;
            }

            // Sliding Carousel Track
            Rectangle {
                x: 8px;
                y: 8px;
                width: 736px;
                height: 100px;
                clip: true;

                Rectangle {
                    x: -clamp((root.selected_app - 2) * 144px, 0px, 432px);
                    y: 0px;
                    width: 1152px;
                    height: 100px;

                    animate x { duration: 160ms; }

                    for app[i] in root.apps: Rectangle {
                        x: i * 144px;
                        y: 0px;
                        width: 144px;
                        height: 100px;
                        border-radius: 16px;

                        // Focused Tile Liquid Glass Plate
                        if (root.active_zone == "apps" && root.selected_app == i): Rectangle {
                            x: 6px;
                            y: 4px;
                            width: parent.width - 12px;
                            height: parent.height - 8px;

                            // Plate Luminous Frosted Glass Body
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 18px;
                                background: (root.current_focus_style == "Minimal Pill") ?
                                    rgba(255, 255, 255, 0.28) :
                                    @linear-gradient(155deg, rgba(255, 255, 255, 0.48) 0%, rgba(235, 242, 250, 0.24) 48%, rgba(255, 255, 255, 0.36) 100%);
                                border-width: 1.25px;
                                border-color: rgba(255, 255, 255, 0.80);

                                // Inset top specular highlight
                                Rectangle {
                                    x: 12px;
                                    y: 1px;
                                    width: parent.width - 24px;
                                    height: 1.2px;
                                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, #ffffff 50%, rgba(255, 255, 255, 0.0) 100%);
                                }
                            }
                        }

                        // App Brand Icon
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (root.active_zone == "apps" && root.selected_app == i) ? 18px : 20px;
                            width: (root.active_zone == "apps" && root.selected_app == i) ? 34px : 30px;
                            height: (root.active_zone == "apps" && root.selected_app == i) ? 34px : 30px;
                            image-fit: contain;
                            source: app.icon;
                            colorize: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(255, 255, 255, 0.85);
                        }

                        // App Label
                        Text {
                            x: 4px;
                            y: 62px;
                            width: parent.width - 8px;
                            horizontal-alignment: center;
                            text: app.name;
                            font-size: (root.active_zone == "apps" && root.selected_app == i) ? 13px : 12px;
                            font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 600 : 500;
                            color: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.78);
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ==========================================
        // --- HDMI INPUTS CAPSULE TRAY ---
        // ==========================================
        Rectangle {
            x: (root.current_layout == "List") ? 530px : (root.width - 392px) / 2;
            y: (root.current_layout == "List") ? 330px : 294px;
            width: 392px;
            height: 32px;

            // Glass Capsule Tray Body
            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 16px;
                frost_image: root.dynamic_frost_image;
                origin_x: (root.current_layout == "List") ? 530px : (root.width - 392px) / 2;
                origin_y: (root.current_layout == "List") ? 330px : 294px;
                glass_tint: @linear-gradient(165deg, rgba(255, 255, 255, 0.20) 0%, rgba(18, 24, 30, 0.32) 100%);
                rim_color: rgba(255, 255, 255, 0.32);
                rim_width: 1px;
                show_specular_hairline: true;
                show_left_rim: false;
            }

            // Segments inside the tray
            for hdmi[h_idx] in root.inputs: Rectangle {
                x: (h_idx == 0) ? 5px :
                   (h_idx == 1) ? 139px :
                   (h_idx == 2) ? 221px : 303px;
                y: 3px;
                width: (h_idx == 0) ? 130px :
                       (h_idx == 1) ? 78px :
                       (h_idx == 2) ? 78px : 84px;
                height: 26px;
                border-radius: 13px;

                // Focused Segment Luminous Liquid Glass Pill
                if (root.active_zone == "inputs" && root.selected_input == h_idx): Rectangle {
                    width: 100%;
                    height: 100%;

                    // Body
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 13px;
                        background: @linear-gradient(165deg, rgba(255, 255, 255, 0.50) 0%, rgba(230, 235, 245, 0.26) 48%, rgba(255, 255, 255, 0.38) 100%);
                        border-width: 1.2px;
                        border-color: rgba(255, 255, 255, 0.75);

                        // Inset specular line
                        Rectangle {
                            x: 8px;
                            y: 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, #ffffff 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }
                }

                // LiveTV Icon - vertically centered
                Image {
                    x: 8px;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                    source: @image-url("assets/icons/livetv.svg");
                    colorize: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : rgba(255, 255, 255, 0.75);
                }

                // HDMI Label - vertically centered with room for connected dot
                Text {
                    x: 25px;
                    y: 0px;
                    width: parent.width - 25px - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: hdmi.label;
                    font-size: 11px;
                    font-weight: (root.active_zone == "inputs" && root.selected_input == h_idx) ? 600 : 500;
                    color: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : #f6f1e7;
                    overflow: elide;
                }

                // Status Dot - vertically centered
                if hdmi.connected: Rectangle {
                    x: parent.width - 15px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: rgba(52, 199, 89, 0.28);
                }
                Rectangle {
                    x: parent.width - 13px;
                    y: (parent.height - 6px) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: hdmi.connected ? #34C759 : rgba(255, 255, 255, 0.28);
                }
            }
        }

        // ==========================================
        // --- UTILITIES CONTROLS ---
        // ==========================================
        // List mode: Right-aligned vertical column
        if root.current_layout == "List": Rectangle {
            x: root.width - 180px - 56px;
            y: 376px;
            width: 180px;
            height: 140px;

            for u[u_idx] in root.utils: Rectangle {
                y: u_idx * 32px;
                width: 180px;
                height: 28px;
                border-radius: 14px;

                if (root.active_zone == "util" && root.selected_util == u_idx): Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 14px;
                    background: @linear-gradient(165deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.16) 100%);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.50);
                }

                Text {
                    x: 0px;
                    y: 5px;
                    width: 148px;
                    horizontal-alignment: right;
                    text: u;
                    font-size: 15px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 400;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.65);
                }

                Image {
                    x: 156px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/quickpanel.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.65);
                }
            }
        }

        // Dock mode: Top-Right Floating Glass Island Capsule
        if root.current_layout == "Dock": Rectangle {
            x: root.width - 396px;
            y: 36px;
            width: 340px;
            height: 32px;

            // Glass Island Body
            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 16px;
                frost_image: root.dynamic_frost_image;
                origin_x: root.width - 396px;
                origin_y: 36px;
                glass_tint: @linear-gradient(165deg, rgba(255, 255, 255, 0.20) 0%, rgba(18, 22, 26, 0.30) 100%);
                rim_color: rgba(255, 255, 255, 0.32);
                rim_width: 1px;
                show_specular_hairline: true;
                show_left_rim: false;
            }

            for u[u_idx] in root.utils: Rectangle {
                x: (u_idx == 0) ? 4px :
                   (u_idx == 1) ? 94px :
                   (u_idx == 2) ? 174px : 252px;
                y: 3px;
                width: (u_idx == 0) ? 86px :
                       (u_idx == 1) ? 76px :
                       (u_idx == 2) ? 74px : 80px;
                height: 26px;
                border-radius: 13px;

                // Focused Luminous Liquid Glass Pill
                if (root.active_zone == "util" && root.selected_util == u_idx): Rectangle {
                    width: 100%;
                    height: 100%;

                    // Body
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 13px;
                        background: @linear-gradient(165deg, rgba(255, 255, 255, 0.48) 0%, rgba(230, 235, 245, 0.24) 48%, rgba(255, 255, 255, 0.36) 100%);
                        border-width: 1.2px;
                        border-color: rgba(255, 255, 255, 0.75);

                        Rectangle {
                            x: 6px;
                            y: 1px;
                            width: parent.width - 12px;
                            height: 1px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, #ffffff 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }
                }

                Image {
                    x: 8px;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/livetv.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.75);
                }

                Text {
                    x: 26px;
                    y: 0px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: u;
                    font-size: 11px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 500;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.75);
                }
            }
        }

        // ==========================================
        // --- NOW PLAYING MUSIC BAR ---
        // ==========================================
        if (root.now_playing_visible): Rectangle {
            x: (root.current_layout == "List") ? 540px : (root.width - 230px) / 2;
            y: (root.current_layout == "List") ? 284px : 252px;
            width: 230px;
            height: 36px;

            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 18px;
                frost_image: root.dynamic_frost_image;
                origin_x: (root.current_layout == "List") ? 540px : (root.width - 230px) / 2;
                origin_y: (root.current_layout == "List") ? 284px : 252px;
                glass_tint: (root.active_zone == "media") ?
                    @linear-gradient(170deg, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.16) 58%, rgba(255, 255, 255, 0.22) 100%) :
                    @linear-gradient(180deg, rgba(18, 22, 25, 0.75) 0%, rgba(12, 16, 20, 0.80) 100%);
                rim_color: (root.active_zone == "media") ? rgba(255, 255, 255, 0.35) : rgba(255, 255, 255, 0.18);
                rim_width: 1px;
                show_specular_hairline: true;
                show_left_rim: false;
            }

            // Music note icon
            Image {
                x: 10px;
                y: 10px;
                width: 16px;
                height: 16px;
                image-fit: contain;
                source: @image-url("assets/icons/applemusic.svg");
                colorize: #ffffff;
            }

            // Track & Artist text
            Text {
                x: 32px;
                y: 5px;
                width: 160px;
                text: root.now_playing_title;
                font-size: 11px;
                font-weight: 600;
                color: #ffffff;
                overflow: elide;
            }

            Text {
                x: 32px;
                y: 19px;
                width: 160px;
                text: root.now_playing_artist;
                font-size: 9px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.70);
                overflow: elide;
            }

            // Play / Pause glyph
            Text {
                x: parent.width - 20px;
                y: 11px;
                text: root.now_playing_playing ? "❚❚" : "▶";
                font-size: 11px;
                color: #ffffff;
            }
        }
    }

    // ==========================================
    // 4. ART MODE OVERLAY (Ambient Gallery View)
    // ==========================================
    if root.art_mode: Rectangle {
        width: 100%;
        height: 100%;

        // Ambient Floating Plaque (Liquid Frosted Glass)
        Rectangle {
            x: 56px;
            y: root.height - 130px;
            width: 440px;
            height: 80px;

            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 20px;
                frost_image: root.dynamic_frost_image;
                origin_x: 56px;
                origin_y: root.height - 130px;
                glass_tint: @linear-gradient(145deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 35%, rgba(18, 22, 28, 0.58) 70%, rgba(10, 14, 18, 0.78) 100%);
                rim_color: rgba(255, 255, 255, 0.28);
                rim_width: 1.2px;
                show_specular_hairline: true;
                show_left_rim: true;
            }

            Text {
                x: 20px;
                y: 12px;
                text: root.art_title;
                font-size: 20px;
                font-weight: 600;
                color: #ffffff;
            }

            Text {
                x: 20px;
                y: 36px;
                text: root.art_artist;
                font-size: 12px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.75);
            }

            Text {
                x: 20px;
                y: 56px;
                text: "‹ › Browse  ·  OK Set as wallpaper  ·  Back Exit";
                font-size: 10px;
                font-weight: 500;
                color: rgba(246, 241, 231, 0.50);
            }

            // Confirmation chip when wallpaper is set
            if root.art_saved_notice: Rectangle {
                x: parent.width - 130px;
                y: 14px;
                width: 116px;
                height: 24px;
                border-radius: 12px;
                background: #10b981;

                Text {
                    x: 0px;
                    y: 4px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "✓ Wallpaper Set";
                    font-size: 11px;
                    font-weight: 600;
                    color: #ffffff;
                }
            }
        }
    }

    // ==========================================
    // 5. MODAL SETTINGS SHEET (Floating Liquid Glass)
    // ==========================================
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        // Subtle ambient veil allowing wallpaper depth to breathe through
        background: rgba(6, 10, 14, 0.40);

        // LEVEL 0: SETTINGS OVERVIEW LIST
        if !root.settings_detail: Rectangle {
            width: 100%;
            height: 100%;

            // Floating Hero Liquid Glass Card
            Rectangle {
                x: (root.width - 760px) / 2;
                y: (root.height - 480px) / 2;
                width: 760px;
                height: 480px;

                LiquidGlassPanel {
                    width: 100%;
                    height: 100%;
                    border-radius: 24px;
                    frost_image: root.dynamic_frost_image;
                    origin_x: (root.width - 760px) / 2;
                    origin_y: (root.height - 480px) / 2;
                    glass_tint: @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.07) 35%, rgba(18, 22, 28, 0.28) 70%, rgba(10, 14, 18, 0.42) 100%);
                    rim_color: rgba(255, 255, 255, 0.35);
                    rim_width: 1.2px;
                    show_specular_hairline: true;
                    show_left_rim: true;
                }

                // Title
                Text {
                    x: 32px;
                    y: 22px;
                    text: "Settings";
                    font-size: 28px;
                    font-weight: 600;
                    color: #ffffff;
                }

                // Clock Chip in Top-Right
                Rectangle {
                    x: parent.width - 110px;
                    y: 22px;
                    width: 78px;
                    height: 28px;
                    border-radius: 14px;
                    background: rgba(255, 255, 255, 0.08);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.15);

                    Text {
                        x: 0px;
                        y: 5px;
                        width: parent.width;
                        horizontal-alignment: center;
                        text: root.clock_text;
                        font-size: 14px;
                        font-weight: 500;
                        color: #ffffff;
                    }
                }

                // 8 Settings Categories List (Inside Panel)
                for s[s_idx] in root.settings_list: Rectangle {
                    x: 32px;
                    y: 64px + s_idx * 44px;
                    width: parent.width - 64px;
                    height: 40px;
                    border-radius: 12px;

                    // Focused elevated luminous plate
                    if (root.selected_setting == s_idx): Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 12px;
                        background: @linear-gradient(165deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 242, 248, 0.88) 100%);
                        border-width: 1.2px;
                        border-color: #ffffff;
                    }

                    // Label & Value
                    Text {
                        x: 18px;
                        y: 4px;
                        height: 18px;
                        vertical-alignment: center;
                        text: s.label;
                        font-size: 14px;
                        font-weight: 600;
                        color: (root.selected_setting == s_idx) ? #111111 : #ffffff;
                    }

                    Text {
                        x: 18px;
                        y: 21px;
                        height: 15px;
                        vertical-alignment: center;
                        text: s.value;
                        font-size: 11px;
                        font-weight: 400;
                        color: (root.selected_setting == s_idx) ? #444444 : rgba(246, 241, 231, 0.68);
                    }

                    Text {
                        x: parent.width - 28px;
                        y: 0px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "›";
                        font-size: 18px;
                        font-weight: 600;
                        color: (root.selected_setting == s_idx) ? #111111 : rgba(255, 255, 255, 0.45);
                    }
                }

                // Bottom Prompt Bar
                Rectangle {
                    x: 32px;
                    y: parent.height - 42px;
                    height: 24px;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 32px;
                        height: 22px;
                        border-radius: 11px;
                        background: rgba(255, 255, 255, 0.20);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.35);

                        Text {
                            x: 0px;
                            y: 3px;
                            width: parent.width;
                            horizontal-alignment: center;
                            text: "OK";
                            font-size: 10px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                    }

                    Text {
                        x: 38px;
                        y: 4px;
                        text: "Open selected group  ·  Back Exit to Home";
                        font-size: 12px;
                        font-weight: 400;
                        color: rgba(246, 241, 231, 0.85);
                    }
                }
            }
        }

        // LEVEL 1: DETAILED SUBMENU OPTIONS
        if root.settings_detail: Rectangle {
            width: 100%;
            height: 100%;

            // Floating Hero Liquid Glass Card
            Rectangle {
                x: (root.width - 760px) / 2;
                y: (root.height - 480px) / 2;
                width: 760px;
                height: 480px;

                LiquidGlassPanel {
                    width: 100%;
                    height: 100%;
                    border-radius: 24px;
                    frost_image: root.dynamic_frost_image;
                    origin_x: (root.width - 760px) / 2;
                    origin_y: (root.height - 480px) / 2;
                    glass_tint: @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.07) 35%, rgba(18, 22, 28, 0.28) 70%, rgba(10, 14, 18, 0.42) 100%);
                    rim_color: rgba(255, 255, 255, 0.35);
                    rim_width: 1.2px;
                    show_specular_hairline: true;
                    show_left_rim: true;
                }

                // Back Button Glass Pill (‹ Settings)
                Rectangle {
                    x: 32px;
                    y: 20px;
                    width: 110px;
                    height: 28px;
                    border-radius: 14px;
                    background: (root.selected_detail_option == -1) ?
                        @linear-gradient(165deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 242, 248, 0.88) 100%) :
                        rgba(255, 255, 255, 0.10);
                    border-width: 1px;
                    border-color: (root.selected_detail_option == -1) ? #ffffff : rgba(255, 255, 255, 0.20);

                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: "‹ Settings";
                        font-size: 12px;
                        font-weight: 600;
                        color: (root.selected_detail_option == -1) ? #111111 : #ffffff;
                    }
                }

                // Submenu Title
                Text {
                    x: 32px;
                    y: 56px;
                    text: root.detail_title;
                    font-size: 26px;
                    font-weight: 600;
                    color: #ffffff;
                }

                // Submenu Description
                Text {
                    x: 32px;
                    y: 88px;
                    text: root.detail_desc;
                    font-size: 12px;
                    font-weight: 400;
                    color: rgba(246, 241, 231, 0.70);
                }

                // Options List (Scrollable)
                Rectangle {
                    x: 32px;
                    y: 114px;
                    width: parent.width - 64px;
                    height: 310px;
                    clip: true;

                    for opt[o_idx] in root.detail_options: Rectangle {
                        x: 0px;
                        y: (o_idx * 48px) - ((root.selected_detail_option > 4) ? (root.selected_detail_option - 4) * 48px : 0px);
                        width: parent.width;
                        height: 44px;
                        border-radius: 12px;

                        // Focused elevated luminous plate
                        if (root.selected_detail_option == o_idx): Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 12px;
                            background: @linear-gradient(165deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 242, 248, 0.88) 100%);
                            border-width: 1.2px;
                            border-color: #ffffff;
                        }

                        animate y { duration: 120ms; }

                        // Radio indicator dot (Apple iOS systemGreen #34C759)
                        Rectangle {
                            x: 16px;
                            y: (parent.height - 12px) / 2;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            border-width: 1.5px;
                            border-color: (root.selected_detail_option == o_idx) ? #111111 : rgba(255, 255, 255, 0.50);
                            background: opt.active ? ((root.selected_detail_option == o_idx) ? #111111 : #34C759) : rgba(0, 0, 0, 0);
                        }

                        // Option Title & Description
                        Text {
                            x: 38px;
                            y: 4px;
                            height: 18px;
                            vertical-alignment: center;
                            text: opt.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: (root.selected_detail_option == o_idx) ? #111111 : #ffffff;
                        }

                        Text {
                            x: 38px;
                            y: 22px;
                            height: 16px;
                            vertical-alignment: center;
                            text: opt.desc;
                            font-size: 11px;
                            font-weight: 400;
                            color: (root.selected_detail_option == o_idx) ? #444444 : rgba(246, 241, 231, 0.65);
                        }
                    }
                }

                // Bottom Prompt
                Rectangle {
                    x: 32px;
                    y: parent.height - 42px;
                    height: 24px;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 32px;
                        height: 22px;
                        border-radius: 11px;
                        background: rgba(255, 255, 255, 0.20);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.35);

                        Text {
                            x: 0px;
                            y: 3px;
                            width: parent.width;
                            horizontal-alignment: center;
                            text: "OK";
                            font-size: 10px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                    }

                    Text {
                        x: 38px;
                        y: 4px;
                        text: "Select option  ·  Back to return";
                        font-size: 12px;
                        font-weight: 400;
                        color: rgba(246, 241, 231, 0.85);
                    }
                }
            }
        }
    }

    // Remote D-pad event capture
    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.key_up(); accept; }
            else if (event.text == Key.DownArrow) { root.key_down(); accept; }
            else if (event.text == Key.LeftArrow) { root.key_left(); accept; }
            else if (event.text == Key.RightArrow) { root.key_right(); accept; }
            else if (event.text == Key.Return) { root.key_ok(); accept; }
            else if (event.text == Key.Escape || event.text == Key.Back) { root.key_back(); accept; }
            else { reject; }
        }
    }
}
