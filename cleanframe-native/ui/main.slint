import "./assets/fonts/Geist-Variable.ttf";
import "./assets/fonts/Newsreader-Variable.ttf";

export struct AppItem {
    id: string,
    name: string,
    pkg: string,
    icon: image,
    brand_color: color,
    in_dock: bool,
}

export struct HdmiItem {
    id: string,
    label: string,
    connected: bool,
}

export struct SettingItem {
    id: string,
    label: string,
    value: string,
}

export struct DetailOption {
    id: string,
    title: string,
    desc: string,
    active: bool,
}

component LiquidGlassPanel inherits Rectangle {
    in property <image> frost_image;
    in property <length> scene_width: 960px;
    in property <length> scene_height: 540px;
    in property <length> origin_x: 0px;
    in property <length> origin_y: 0px;
    in property <brush> glass_tint: @linear-gradient(155deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.05) 32%, rgba(18, 24, 32, 0.22) 72%, rgba(12, 16, 22, 0.36) 100%);
    in property <color> rim_color: rgba(255, 255, 255, 0.35);
    in property <length> rim_width: 1.25px;
    in property <bool> show_specular_hairline: true;
    in property <bool> show_left_rim: false;
    in property <bool> has_shadow: false;

    // Optical Glass Substrate (liquid-rust pure floating glass, zero muddy drop shadow)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        clip: true;

        // 1:1 Co-located blurred wallpaper computed dynamically at runtime (Snell refraction + dispersion)
        Image {
            x: -root.origin_x;
            y: -root.origin_y;
            width: root.scene_width;
            height: root.scene_height;
            image-fit: cover;
            source: root.frost_image;
        }

        // Pure Translucent Optical Glass Body Tint
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: root.border-radius;
            background: root.glass_tint;
        }

        // Convex Squircle Meniscus Sheen (Subtle light reflection across upper curved bevel)
        Rectangle {
            x: 2px;
            y: 1px;
            width: parent.width - 4px;
            height: parent.height * 0.44;
            border-radius: root.border-radius - 2px;
            background: @linear-gradient(180deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.0) 100%);
        }

        // Specular Lit Top Rim Glint (Directional light from above L=(0,-1))
        if root.show_specular_hairline: Rectangle {
            x: 8px;
            y: 1px;
            width: parent.width - 16px;
            height: 1.25px;
            border-radius: 0.6px;
            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.65) 50%, rgba(255, 255, 255, 0.0) 100%);
        }

        // iOS 27 Darkened Perimeter Hairline Burn
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: root.border-radius;
            border-width: 0.75px;
            border-color: rgba(255, 255, 255, 0.16);
        }
    }
}

export component MainWindow inherits Window {
    width: 960px;
    height: 540px;
    default-font-family: (root.current_font == "Newsreader") ? "Newsreader" :
                         (root.current_font == "Geist") ? "Geist" : "sans-serif";

    // Appearance State Properties
    in property <string> clock_text: "1:54";
    in property <string> focused_caption: "Prime Video";
    in property <int> wallpaper_idx: 3; // 0..14 (All 15 Curated Photographic Wallpapers)
    in property <string> current_layout: "List"; // "List" | "Dock"
    in property <string> current_font: "Manrope"; // "Manrope" | "Newsreader" | "Geist"
    in property <string> current_material: "Frost"; // "Frost" | "Soft" | "Obsidian Tint" | "Clear"
    in property <string> current_focus_style: "Glass Plate"; // "Glass Plate" | "Round" | "Minimal Type"
    in property <string> current_icon_pack: "CleanFrame default"; // "CleanFrame default" | "Full Color" | custom
    in property <bool> is_custom_icon_pack: false;
    in property <image> dynamic_frost_image;
    in property <image> dock_frost_image;
    in property <image> focus_lens_image;
    in property <image> focus_list_lens_image;
    in property <image> round_focus_lens_image;

    // Primary Home Dock Apps (Dynamic)
    in-out property <[AppItem]> apps: [
        { id: "youtube", name: "SmartTube", pkg: "org.smarttube.stable", icon: @image-url("assets/icons/youtube.svg"), brand_color: #FF0000, in_dock: true },
        { id: "spotify", name: "Spotify", pkg: "com.spotify.tv.android", icon: @image-url("assets/icons/spotify.svg"), brand_color: #1DB954, in_dock: true },
        { id: "appletv", name: "Apple TV", pkg: "com.apple.atve.androidtv.appletv", icon: @image-url("assets/icons/appletv.svg"), brand_color: #FFFFFF, in_dock: true },
        { id: "primevideo", name: "Prime Video", pkg: "com.amazon.amazonvideo.livingroom", icon: @image-url("assets/icons/primevideo.svg"), brand_color: #00A8E1, in_dock: true },
        { id: "netflix", name: "Netflix", pkg: "com.netflix.ninja", icon: @image-url("assets/icons/netflix.svg"), brand_color: #E50914, in_dock: true },
        { id: "aurora", name: "Aurora Store", pkg: "com.aurora.store", icon: @image-url("assets/icons/aurora.svg"), brand_color: #01C38D, in_dock: true },
        { id: "projectivy", name: "Projectivy Launcher", pkg: "com.spocky.projengmenu", icon: @image-url("assets/icons/projectivy.svg"), brand_color: #FF9800, in_dock: true },
        { id: "settings", name: "TV Settings", pkg: "android.settings.SETTINGS", icon: @image-url("assets/icons/tvsettings.svg"), brand_color: #007AFF, in_dock: true }
    ];
    in-out property <int> selected_app: 3;

    // All Applications Master Catalog & Installed Apps
    in-out property <[AppItem]> all_apps_list: [
        { id: "youtube", name: "SmartTube", pkg: "org.smarttube.stable", icon: @image-url("assets/icons/youtube.svg"), brand_color: #FF0000, in_dock: true },
        { id: "spotify", name: "Spotify", pkg: "com.spotify.tv.android", icon: @image-url("assets/icons/spotify.svg"), brand_color: #1DB954, in_dock: true },
        { id: "appletv", name: "Apple TV", pkg: "com.apple.atve.androidtv.appletv", icon: @image-url("assets/icons/appletv.svg"), brand_color: #FFFFFF, in_dock: true },
        { id: "primevideo", name: "Prime Video", pkg: "com.amazon.amazonvideo.livingroom", icon: @image-url("assets/icons/primevideo.svg"), brand_color: #00A8E1, in_dock: true },
        { id: "netflix", name: "Netflix", pkg: "com.netflix.ninja", icon: @image-url("assets/icons/netflix.svg"), brand_color: #E50914, in_dock: true },
        { id: "aurora", name: "Aurora Store", pkg: "com.aurora.store", icon: @image-url("assets/icons/aurora.svg"), brand_color: #01C38D, in_dock: true },
        { id: "projectivy", name: "Projectivy Launcher", pkg: "com.spocky.projengmenu", icon: @image-url("assets/icons/projectivy.svg"), brand_color: #FF9800, in_dock: true },
        { id: "settings", name: "TV Settings", pkg: "android.settings.SETTINGS", icon: @image-url("assets/icons/tvsettings.svg"), brand_color: #007AFF, in_dock: true },
        { id: "plex", name: "Plex", pkg: "com.plexapp.android", icon: @image-url("assets/icons/plex.svg"), brand_color: #E5A00D, in_dock: false },
        { id: "jellyfin", name: "Jellyfin", pkg: "org.jellyfin.androidtv", icon: @image-url("assets/icons/jellyfin.svg"), brand_color: #AA5CC3, in_dock: false },
        { id: "tubi", name: "Tubi TV", pkg: "com.tubitv", icon: @image-url("assets/icons/tubi.svg"), brand_color: #FA3200, in_dock: false },
        { id: "disneyplus", name: "Disney+", pkg: "com.disney.disneyplus", icon: @image-url("assets/icons/disneyplus.svg"), brand_color: #113CCF, in_dock: false },
        { id: "stremio", name: "Stremio", pkg: "com.stremio.one", icon: @image-url("assets/icons/stremio.svg"), brand_color: #7452A8, in_dock: false },
        { id: "livetv", name: "Live TV", pkg: "com.android.tv", icon: @image-url("assets/icons/livetv.svg"), brand_color: #5856D6, in_dock: false },
        { id: "mediaplayer", name: "Media Player", pkg: "com.android.gallery3d", icon: @image-url("assets/icons/mediaplayer.svg"), brand_color: #34C759, in_dock: false },
        { id: "aptoide", name: "Aptoide TV", pkg: "cm.aptoidetv.pt", icon: @image-url("assets/icons/aptoide.svg"), brand_color: #FF5722, in_dock: false }
    ];
    in-out property <bool> all_apps_open: false;
    in-out property <int> selected_all_app: 0;
    in-out property <bool> all_apps_action_open: false;
    in-out property <int> selected_all_app_action: 0; // 0: Launch, 1: Toggle Dock

    // HDMI Inputs Shelf
    in property <[HdmiItem]> inputs: [
        { id: "hw1", label: "HDMI 1 · Mac", connected: true },
        { id: "hw2", label: "HDMI 2", connected: false },
        { id: "hw3", label: "HDMI 3", connected: true },
        { id: "av", label: "AV", connected: false }
    ];
    in property <int> selected_input: 0;

    // Utilities Shelf: 4 Controls
    in property <[string]> utils: ["Art Mode", "All apps", "Inputs", "Settings"];
    in property <int> selected_util: 0;

    // Active Navigation Zone: "apps" | "inputs" | "util" | "media"
    in property <string> active_zone: "apps";

    // Dynamic Dual-Spring Liquid Morph & Physics (Apple Liquid Glass Model)
    // Dock Apps Morph (Horizontal)
    property <length> target_dock_x: root.selected_app * 144px + 6px;
    property <length> dock_lead_x: target_dock_x;
    animate dock_lead_x { duration: 190ms; easing: cubic-bezier(0.12, 0.95, 0.35, 1.0); }
    property <length> dock_trail_x: target_dock_x;
    animate dock_trail_x { duration: 320ms; easing: cubic-bezier(0.18, 1.55, 0.35, 1.0); }
    property <length> dock_lead_diff: dock_lead_x - target_dock_x;
    property <length> dock_trail_diff: dock_trail_x - target_dock_x;
    property <length> dock_flow_dx: dock_lead_x - dock_trail_x;
    property <length> dock_flow_abs: (dock_flow_dx > 0px) ? dock_flow_dx : -dock_flow_dx;
    property <length> dock_overshoot_abs: (dock_trail_diff > 0px) ? dock_trail_diff : -dock_trail_diff;
    property <length> anim_dock_x: (dock_lead_x + dock_trail_x) * 0.5;
    property <length> dock_stretch_w: (dock_lead_diff == 0px && dock_trail_diff != 0px) ?
        (-clamp(dock_overshoot_abs * 0.70, 0px, 14px)) :
        clamp(dock_flow_abs * 0.52, 0px, 38px);
    property <length> dock_squash_h: dock_stretch_w * 0.40;

    // List Apps Morph (Vertical)
    property <length> target_list_y: root.selected_app * 52px;
    property <length> list_lead_y: target_list_y;
    animate list_lead_y { duration: 180ms; easing: cubic-bezier(0.12, 0.95, 0.35, 1.0); }
    property <length> list_trail_y: target_list_y;
    animate list_trail_y { duration: 300ms; easing: cubic-bezier(0.18, 1.52, 0.35, 1.0); }
    property <length> list_lead_diff: list_lead_y - target_list_y;
    property <length> list_trail_diff: list_trail_y - target_list_y;
    property <length> list_flow_dy: list_lead_y - list_trail_y;
    property <length> list_flow_abs: (list_flow_dy > 0px) ? list_flow_dy : -list_flow_dy;
    property <length> list_overshoot_abs: (list_trail_diff > 0px) ? list_trail_diff : -list_trail_diff;
    property <length> anim_list_y: (list_lead_y + list_trail_y) * 0.5;
    property <length> list_stretch_h: (list_lead_diff == 0px && list_trail_diff != 0px) ?
        (-clamp(list_overshoot_abs * 0.65, 0px, 8px)) :
        clamp(list_flow_abs * 0.45, 0px, 18px);
    property <length> list_squash_w: list_stretch_h * 0.50;

    // HDMI Inputs Tray Morph (Horizontal)
    property <length> target_hdmi_x: (root.selected_input == 0) ? 5px :
                                     (root.selected_input == 1) ? 139px :
                                     (root.selected_input == 2) ? 221px : 303px;
    property <length> target_hdmi_w: (root.selected_input == 0) ? 130px :
                                     (root.selected_input == 1) ? 78px :
                                     (root.selected_input == 2) ? 78px : 84px;
    property <length> hdmi_lead_x: target_hdmi_x;
    property <length> hdmi_lead_w: target_hdmi_w;
    animate hdmi_lead_x, hdmi_lead_w { duration: 180ms; easing: cubic-bezier(0.12, 0.95, 0.35, 1.0); }
    property <length> hdmi_trail_x: target_hdmi_x;
    property <length> hdmi_trail_w: target_hdmi_w;
    animate hdmi_trail_x, hdmi_trail_w { duration: 300ms; easing: cubic-bezier(0.18, 1.52, 0.35, 1.0); }
    property <length> hdmi_lead_diff: hdmi_lead_x - target_hdmi_x;
    property <length> hdmi_trail_diff: hdmi_trail_x - target_hdmi_x;
    property <length> hdmi_flow_dx: hdmi_lead_x - hdmi_trail_x;
    property <length> hdmi_flow_abs: (hdmi_flow_dx > 0px) ? hdmi_flow_dx : -hdmi_flow_dx;
    property <length> hdmi_overshoot_abs: (hdmi_trail_diff > 0px) ? hdmi_trail_diff : -hdmi_trail_diff;
    property <length> anim_hdmi_x: (hdmi_lead_x + hdmi_trail_x) * 0.5;
    property <length> anim_hdmi_w: (hdmi_lead_w + hdmi_trail_w) * 0.5;
    property <length> hdmi_stretch_w: (hdmi_lead_diff == 0px && hdmi_trail_diff != 0px) ?
        (-clamp(hdmi_overshoot_abs * 0.60, 0px, 8px)) :
        clamp(hdmi_flow_abs * 0.42, 0px, 22px);
    property <length> hdmi_squash_h: hdmi_stretch_w * 0.38;

    // Utilities Morph (Horizontal)
    property <length> target_util_x: (root.selected_util == 0) ? 4px :
                                     (root.selected_util == 1) ? 94px :
                                     (root.selected_util == 2) ? 174px : 252px;
    property <length> target_util_w: (root.selected_util == 0) ? 86px :
                                     (root.selected_util == 1) ? 76px :
                                     (root.selected_util == 2) ? 74px : 80px;
    property <length> util_lead_x: target_util_x;
    property <length> util_lead_w: target_util_w;
    animate util_lead_x, util_lead_w { duration: 180ms; easing: cubic-bezier(0.12, 0.95, 0.35, 1.0); }
    property <length> util_trail_x: target_util_x;
    property <length> util_trail_w: target_util_w;
    animate util_trail_x, util_trail_w { duration: 300ms; easing: cubic-bezier(0.18, 1.52, 0.35, 1.0); }
    property <length> util_lead_diff: util_lead_x - target_util_x;
    property <length> util_trail_diff: util_trail_x - target_util_x;
    property <length> util_flow_dx: util_lead_x - util_trail_x;
    property <length> util_flow_abs: (util_flow_dx > 0px) ? util_flow_dx : -util_flow_dx;
    property <length> util_overshoot_abs: (util_trail_diff > 0px) ? util_trail_diff : -util_trail_diff;
    property <length> anim_util_x: (util_lead_x + util_trail_x) * 0.5;
    property <length> anim_util_w: (util_lead_w + util_trail_w) * 0.5;
    property <length> util_stretch_w: (util_lead_diff == 0px && util_trail_diff != 0px) ?
        (-clamp(util_overshoot_abs * 0.60, 0px, 8px)) :
        clamp(util_flow_abs * 0.42, 0px, 20px);
    property <length> util_squash_h: util_stretch_w * 0.38;

    // Settings Categories Morph (Level 0, Vertical)
    property <length> target_setting_y: root.selected_setting * 66px;
    property <length> setting_lead_y: target_setting_y;
    animate setting_lead_y { duration: 180ms; easing: cubic-bezier(0.12, 0.95, 0.35, 1.0); }
    property <length> setting_trail_y: target_setting_y;
    animate setting_trail_y { duration: 290ms; easing: cubic-bezier(0.18, 1.48, 0.35, 1.0); }
    property <length> setting_lead_diff: setting_lead_y - target_setting_y;
    property <length> setting_trail_diff: setting_trail_y - target_setting_y;
    property <length> setting_flow_dy: setting_lead_y - setting_trail_y;
    property <length> setting_flow_abs: (setting_flow_dy > 0px) ? setting_flow_dy : -setting_flow_dy;
    property <length> setting_overshoot_abs: (setting_trail_diff > 0px) ? setting_trail_diff : -setting_trail_diff;
    property <length> anim_setting_y: (setting_lead_y + setting_trail_y) * 0.5;
    property <length> setting_stretch_h: (setting_lead_diff == 0px && setting_trail_diff != 0px) ?
        (-clamp(setting_overshoot_abs * 0.55, 0px, 7px)) :
        clamp(setting_flow_abs * 0.40, 0px, 16px);
    property <length> setting_squash_w: setting_stretch_h * 0.55;

    // Settings Detail Morph (Level 1, Vertical)
    property <length> target_detail_y: (root.selected_detail_option * 44px) - ((root.selected_detail_option > 5) ? (root.selected_detail_option - 5) * 44px : 0px);
    property <length> detail_lead_y: target_detail_y;
    animate detail_lead_y { duration: 180ms; easing: cubic-bezier(0.12, 0.95, 0.35, 1.0); }
    property <length> detail_trail_y: target_detail_y;
    animate detail_trail_y { duration: 290ms; easing: cubic-bezier(0.18, 1.48, 0.35, 1.0); }
    property <length> detail_lead_diff: detail_lead_y - target_detail_y;
    property <length> detail_trail_diff: detail_trail_y - target_detail_y;
    property <length> detail_flow_dy: detail_lead_y - detail_trail_y;
    property <length> detail_flow_abs: (detail_flow_dy > 0px) ? detail_flow_dy : -detail_flow_dy;
    property <length> detail_overshoot_abs: (detail_trail_diff > 0px) ? detail_trail_diff : -detail_trail_diff;
    property <length> anim_detail_y: (detail_lead_y + detail_trail_y) * 0.5;
    property <length> detail_stretch_h: (detail_lead_diff == 0px && detail_trail_diff != 0px) ?
        (-clamp(detail_overshoot_abs * 0.55, 0px, 7px)) :
        clamp(detail_flow_abs * 0.40, 0px, 16px);
    property <length> detail_squash_w: detail_stretch_h * 0.55;

    // Now Playing State (Default false, matches webview on TV when no media active)
    in property <bool> now_playing_visible: false;
    in property <string> now_playing_title: "CleanFrame Ambient";
    in property <string> now_playing_artist: "The Frame Audio";
    in property <bool> now_playing_playing: false;

    // Art Mode State
    in property <bool> art_mode: false;
    in property <string> art_title: "Mountain valley";
    in property <string> art_artist: "Aniket Deole · Unsplash";
    in property <bool> art_saved_notice: false;

    // Settings Navigation State
    in property <bool> settings_open: false;
    in property <bool> settings_detail: false;
    in property <string> detail_title: "Background";
    in property <string> detail_desc: "Choose a photographic background or solid color.";
    in property <string> detail_back_text: "‹ Settings";
    in property <int> selected_setting: 0;
    in property <int> selected_detail_option: 0;

    // Refraction & Optics Controls (liquid-rust demo: default 1.00)
    in-out property <float> refraction_value: 1.00;
    in property <string> refraction_display: "1.00";
    in property <string> refraction_subcaption: "Material { refraction: 1.00, depth: 52.0pt, η: 1.50 }";

    // Appearance & Tone Controls (liquid-rust demo: default Clear)
    in-out property <string> appearance_preset: "Clear";
    in-out property <float> transparency_value: 0.00;
    in property <string> transparency_display: "Clear";

    // Appearance Toggle Chips (From liquid-rust demo page)
    in-out property <bool> opt_dark: true;
    in-out property <bool> opt_contrast: false;
    in-out property <bool> opt_reduce_motion: false;
    in-out property <bool> opt_reduce_transparency: false;
    in-out property <bool> opt_physics: true;
    in-out property <bool> opt_liquid_merge: true;

    // Appearance panel navigation focus (0..2 presets, 3 refraction, 4 transparency, 5..10 chips)
    in-out property <bool> in_appearance_panel: false;
    in-out property <int> appearance_focus_index: 3;

    // 4 Primary Nested Settings Categories
    in property <[SettingItem]> settings_list: [
        { id: "dock_nav", label: "Dock & Navigation", value: "Focus Item · Dock Settings" },
        { id: "wallpaper_type", label: "Wallpaper & Typography", value: "15 Landscapes · 3 Fonts" },
        { id: "visual_effects", label: "Visual Effects & Accessibility", value: "Dark Mode · Physics · Liquid" },
        { id: "system_inputs", label: "System & Inputs", value: "HDMI Sources · Apps · TV Settings" }
    ];

    in property <[DetailOption]> detail_options: [];

    // Callbacks to Rust Controller
    callback key_up();
    callback key_down();
    callback key_left();
    callback key_right();
    callback key_ok();
    callback key_back();
    callback set_refraction(float);
    callback set_transparency(float);
    callback set_appearance_preset(string);
    callback toggle_chip(string);

    // 1. DYNAMIC PHOTOGRAPHIC WALLPAPER (All 15 Curated Artworks)
    Image {
        width: 100%;
        height: 100%;
        source: (root.wallpaper_idx == 0) ? @image-url("assets/wallpapers/misty.jpg") :
                (root.wallpaper_idx == 1) ? @image-url("assets/wallpapers/cove.jpg") :
                (root.wallpaper_idx == 2) ? @image-url("assets/wallpapers/forest.jpg") :
                (root.wallpaper_idx == 3) ? @image-url("assets/wallpapers/valley.jpg") :
                (root.wallpaper_idx == 4) ? @image-url("assets/wallpapers/night.jpg") :
                (root.wallpaper_idx == 5) ? @image-url("assets/wallpapers/peaks.jpg") :
                (root.wallpaper_idx == 6) ? @image-url("assets/wallpapers/bridge.jpg") :
                (root.wallpaper_idx == 7) ? @image-url("assets/wallpapers/ridge.jpg") :
                (root.wallpaper_idx == 8) ? @image-url("assets/wallpapers/golden.jpg") :
                (root.wallpaper_idx == 9) ? @image-url("assets/wallpapers/summit.jpg") :
                (root.wallpaper_idx == 10) ? @image-url("assets/wallpapers/goldcoast.jpg") :
                (root.wallpaper_idx == 11) ? @image-url("assets/wallpapers/sydney.jpg") :
                (root.wallpaper_idx == 12) ? @image-url("assets/wallpapers/amber.jpg") :
                (root.wallpaper_idx == 13) ? @image-url("assets/wallpapers/mint.jpg") :
                @image-url("assets/wallpapers/alpine.jpg");
        image-fit: cover;
    }

    // Material Scrim Overlays (Clean separate top shade, list side scrim, and bottom scrim)
    // Preserves wallpaper clarity in the center matching webview .shade and .scrim
    if !root.art_mode: Rectangle {
        width: 100%;
        height: 100%;

        // Top shade for clock and utilities legibility across all bright wallpapers
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 180px;
            background: @linear-gradient(180deg, rgba(2, 6, 10, 0.45) 0%, rgba(2, 6, 10, 0.22) 45%, rgba(2, 6, 10, 0.06) 78%, rgba(2, 6, 10, 0.0) 100%);
        }

        // Left shade for List mode legibility
        if root.current_layout == "List": Rectangle {
            x: 0px;
            y: 0px;
            width: 440px;
            height: 100%;
            background: @linear-gradient(90deg, rgba(2, 6, 10, 0.45) 0%, rgba(2, 6, 10, 0.20) 70%, rgba(2, 6, 10, 0.0) 100%);
        }

        // Bottom scrim for dock and HDMI legibility
        Rectangle {
            x: 0px;
            y: 260px;
            width: 100%;
            height: 280px;
            background: @linear-gradient(180deg, rgba(2, 6, 10, 0.0) 0%, rgba(2, 6, 10, 0.16) 40%, rgba(2, 6, 10, 0.38) 100%);
        }
    }

    // 2. CLOCK & FOCUSED ITEM CAPTION
    // In DOCK layout: positioned at Top-Left (matching real_tv_webview_restored.png)
    // In LIST layout: positioned at Top-Right (matching list layout design)
    if (!root.settings_open && !root.art_mode && !root.all_apps_open): Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 36px;
            text: root.clock_text;
            font-size: 46px;
            font-weight: 500;
            color: #ffffff;
        }

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 92px;
            text: root.focused_caption;
            font-size: 19px;
            font-weight: 500;
            color: rgba(246, 241, 231, 0.95);
        }
    }

    // 3. HOME ELEMENTS (Hidden in Art Mode & Settings)
    if (!root.settings_open && !root.art_mode && !root.all_apps_open): Rectangle {
        width: 100%;
        height: 100%;

        // ==========================================
        // --- LIST LAYOUT (Photographic Typography) ---
        // ==========================================
        if root.current_layout == "List": Rectangle {
            x: 56px;
            y: 74px;
            width: 420px;
            height: 440px;

            // Liquid Frosted Glass Selection Capsule (Morphing & Jiggling - Pure Liquid Lens)
            if (root.current_focus_style == "Glass Plate"): Rectangle {
                x: root.list_squash_w * 0.5;
                y: root.anim_list_y - root.list_stretch_h * 0.5;
                width: 260px - root.list_squash_w;
                height: 48px + root.list_stretch_h;
                border-radius: (48px + root.list_stretch_h) / 2;
                clip: true;
                opacity: (root.active_zone == "apps") ? 1.0 : 0.0;

                animate opacity { duration: 160ms; easing: ease-out; }

                // 1. Co-located Optical Refracted Wallpaper
                Image {
                    x: -(56px + root.list_squash_w * 0.5);
                    y: -(74px + root.anim_list_y - root.list_stretch_h * 0.5);
                    width: root.width;
                    height: root.height;
                    image-fit: cover;
                    source: root.dynamic_frost_image;
                }

                // 2. Optical Glass Liquid Lens Texture with Refractive Edge & Specular Rim
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.focus_list_lens_image;
                }
            }

            // Liquid Frosted Glass Round Focus Lens (List mode circular icon highlight)
            if (root.current_focus_style == "Round"): Rectangle {
                x: 4px;
                y: root.anim_list_y + 2px - root.list_stretch_h * 0.5;
                width: 44px;
                height: 44px + root.list_stretch_h;
                border-radius: (44px + root.list_stretch_h) / 2;
                clip: true;
                opacity: (root.active_zone == "apps") ? 1.0 : 0.0;

                animate opacity { duration: 160ms; easing: ease-out; }

                Image {
                    x: -(56px + 4px);
                    y: -(74px + root.anim_list_y + 2px - root.list_stretch_h * 0.5);
                    width: root.width;
                    height: root.height;
                    image-fit: cover;
                    source: root.dynamic_frost_image;
                }

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.round_focus_lens_image;
                }
            }

            for app[i] in root.apps: Rectangle {
                y: i * 52px;
                width: 320px;
                height: 48px;

                // App Brand Icon
                if (!root.is_custom_icon_pack): Image {
                    x: 14px;
                    y: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 9px : 11px;
                    width: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 30px : 26px;
                    height: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 30px : 26px;
                    image-fit: contain;
                    source: app.icon;
                    colorize: (root.current_icon_pack == "Full Color") ?
                        app.brand_color :
                        ((root.active_zone == "apps" && root.selected_app == i) ? #ffffff :
                        (root.current_focus_style == "Minimal Type" ? rgba(255, 255, 255, 0.75) : rgba(255, 255, 255, 0.92)));

                    animate y, width, height { duration: 250ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                }
                if (root.is_custom_icon_pack): Image {
                    x: 14px;
                    y: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 9px : 11px;
                    width: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 30px : 26px;
                    height: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 30px : 26px;
                    image-fit: contain;
                    source: app.icon;

                    animate y, width, height { duration: 250ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                }

                // App Name
                Text {
                    x: 52px;
                    y: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 7px : 9px;
                    text: app.name;
                    font-size: (root.active_zone == "apps" && root.selected_app == i) ?
                        (root.current_focus_style == "Minimal Type" ? 28px : 26px) : 24px;
                    font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 700 : 500;
                    color: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff :
                        (root.current_focus_style == "Minimal Type" ? rgba(255, 255, 255, 0.75) : rgba(255, 255, 255, 0.92));

                    animate y, font-size { duration: 250ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                }
            }
        }

        // ==========================================
        // --- DOCK LAYOUT (Liquid Frosted Glass) ---
        // ==========================================
        // 960x540 geometry: width: 752px, height: 116px, y: 338px
        if root.current_layout == "Dock": Rectangle {
            x: (root.width - 752px) / 2;
            y: 338px;
            width: 752px;
            height: 116px;

            // Liquid Glass Backdrop Mat
            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 26px;
                frost_image: root.dock_frost_image;
                origin_x: (root.width - 752px) / 2;
                origin_y: 338px;
                glass_tint: (root.current_material == "Tinted") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.28) 0%, rgba(0, 136, 255, 0.25) 25%, rgba(0, 68, 160, 0.45) 70%, rgba(6, 12, 24, 0.65) 100%) :
                    (root.current_material == "Obsidian Tint") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.12) 0%, rgba(14, 18, 26, 0.72) 25%, rgba(6, 10, 16, 0.88) 100%) :
                    (root.current_material == "Frost") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.08) 22%, rgba(18, 24, 32, 0.48) 60%, rgba(10, 14, 20, 0.68) 100%) :
                    (root.current_material == "Clear") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.01) 25%, rgba(12, 16, 22, 0.25) 100%) :
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.06) 25%, rgba(18, 22, 28, 0.45) 65%, rgba(10, 14, 18, 0.62) 100%);
                rim_color: (root.current_material == "Tinted") ? rgba(80, 180, 255, 0.65) :
                           (root.current_material == "Obsidian Tint") ? rgba(255, 255, 255, 0.22) :
                           (root.current_material == "Frost") ? rgba(255, 255, 255, 0.55) :
                           (root.current_material == "Clear") ? rgba(255, 255, 255, 0.22) :
                           rgba(255, 255, 255, 0.34);
                rim_width: 1.25px;
                show_specular_hairline: true;
                show_left_rim: true;
            }

            // Sliding Carousel Track
            Rectangle {
                x: 8px;
                y: 8px;
                width: 736px;
                height: 100px;
                clip: true;

                Rectangle {
                    x: -clamp((root.selected_app - 2) * 144px, 0px, max(0px, (root.apps.length - 5) * 144px));
                    y: 0px;
                    width: max(1152px, root.apps.length * 144px);
                    height: 100px;

                    animate x { duration: 280ms; easing: cubic-bezier(0.25, 1.25, 0.5, 1.0); }

                    // Liquid Glass Droplet Focus Container (Glass Plate - matching liquid-rust)
                    if (root.current_focus_style == "Glass Plate"): Rectangle {
                        x: root.anim_dock_x - root.dock_stretch_w * 0.5;
                        y: 4px + root.dock_squash_h * 0.5;
                        width: 132px + root.dock_stretch_w;
                        height: 92px - root.dock_squash_h;
                        opacity: (root.active_zone == "apps") ? 1.0 : 0.0;

                        animate opacity { duration: 160ms; easing: ease-out; }

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.focus_lens_image;
                        }
                    }

                    // Liquid Glass Circular Focus Container (Round Lens)
                    if (root.current_focus_style == "Round"): Rectangle {
                        x: root.anim_dock_x + (132px - 92px) * 0.5 - root.dock_stretch_w * 0.25;
                        y: 4px + root.dock_squash_h * 0.25;
                        width: 92px + root.dock_stretch_w * 0.5;
                        height: 92px - root.dock_squash_h * 0.5;
                        border-radius: (92px - root.dock_squash_h * 0.5) / 2;
                        opacity: (root.active_zone == "apps") ? 1.0 : 0.0;

                        animate opacity { duration: 160ms; easing: ease-out; }

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.round_focus_lens_image;
                        }
                    }

                    for app[i] in root.apps: Rectangle {
                        x: i * 144px;
                        y: 0px;
                        width: 144px;
                        height: 100px;
                        border-radius: 16px;

                        // App Brand Icon
                        if (!root.is_custom_icon_pack): Image {
                            x: (parent.width - self.width) / 2;
                            y: (root.active_zone == "apps" && root.selected_app == i) ?
                                (root.current_focus_style == "Minimal Type" ? 14px : (root.current_focus_style == "Round" ? 16px : 18px)) : 20px;
                            width: (root.active_zone == "apps" && root.selected_app == i) ?
                                (root.current_focus_style == "Minimal Type" ? 40px : (root.current_focus_style == "Round" ? 36px : 34px)) : 30px;
                            height: (root.active_zone == "apps" && root.selected_app == i) ?
                                (root.current_focus_style == "Minimal Type" ? 40px : (root.current_focus_style == "Round" ? 36px : 34px)) : 30px;
                            image-fit: contain;
                            source: app.icon;
                            colorize: (root.current_icon_pack == "Full Color") ?
                                app.brand_color :
                                ((root.active_zone == "apps" && root.selected_app == i) ? #ffffff :
                                (root.current_focus_style == "Minimal Type" ? rgba(255, 255, 255, 0.75) : rgba(255, 255, 255, 0.90)));

                            animate y, width, height { duration: 250ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                        }
                        if (root.is_custom_icon_pack): Image {
                            x: (parent.width - self.width) / 2;
                            y: (root.active_zone == "apps" && root.selected_app == i) ?
                                (root.current_focus_style == "Minimal Type" ? 14px : (root.current_focus_style == "Round" ? 16px : 18px)) : 20px;
                            width: (root.active_zone == "apps" && root.selected_app == i) ?
                                (root.current_focus_style == "Minimal Type" ? 40px : (root.current_focus_style == "Round" ? 36px : 34px)) : 30px;
                            height: (root.active_zone == "apps" && root.selected_app == i) ?
                                (root.current_focus_style == "Minimal Type" ? 40px : (root.current_focus_style == "Round" ? 36px : 34px)) : 30px;
                            image-fit: contain;
                            source: app.icon;

                            animate y, width, height { duration: 250ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                        }

                        // App Label
                        Text {
                            x: 4px;
                            y: (root.active_zone == "apps" && root.selected_app == i && root.current_focus_style == "Minimal Type") ? 64px : (root.current_focus_style == "Round" ? 59px : 62px);
                            width: parent.width - 8px;
                            horizontal-alignment: center;
                            text: app.name;
                            font-size: (root.active_zone == "apps" && root.selected_app == i) ?
                                (root.current_focus_style == "Minimal Type" ? 14px : (root.current_focus_style == "Round" ? 12px : 13px)) : 12px;
                            font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 700 : 500;
                            color: (root.active_zone == "apps" && root.selected_app == i) ?
                                #ffffff :
                                (root.current_focus_style == "Minimal Type" ? rgba(255, 255, 255, 0.75) : rgba(255, 255, 255, 0.92));
                            overflow: elide;

                            animate y { duration: 250ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                        }
                    }
                }
            }
        }

        // ==========================================
        // --- HDMI INPUTS CAPSULE TRAY ---
        // ==========================================
        Rectangle {
            x: (root.current_layout == "List") ? 530px : (root.width - 392px) / 2;
            y: (root.current_layout == "List") ? 330px : 294px;
            width: 392px;
            height: 32px;

            // Glass Capsule Tray Body
            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 16px;
                frost_image: root.dynamic_frost_image;
                origin_x: (root.current_layout == "List") ? 530px : (root.width - 392px) / 2;
                origin_y: (root.current_layout == "List") ? 330px : 294px;
                glass_tint: (root.current_material == "Tinted") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.28) 0%, rgba(0, 136, 255, 0.25) 30%, rgba(0, 68, 160, 0.55) 100%) :
                    (root.current_material == "Obsidian Tint") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.12) 0%, rgba(10, 14, 20, 0.78) 100%) :
                    (root.current_material == "Frost") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.28) 0%, rgba(20, 26, 34, 0.55) 30%, rgba(12, 16, 22, 0.68) 100%) :
                    (root.current_material == "Clear") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.10) 0%, rgba(12, 16, 22, 0.35) 100%) :
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(16, 20, 28, 0.58) 100%);
                rim_color: rgba(255, 255, 255, 0.32);
                rim_width: 1px;
                show_specular_hairline: true;
                show_left_rim: false;
            }

            // Liquid Glass Selection Pill (Morphing & Jiggling - Pure Liquid Lens)
            Rectangle {
                x: root.anim_hdmi_x - root.hdmi_stretch_w * 0.5;
                y: 3px + root.hdmi_squash_h * 0.5;
                width: root.anim_hdmi_w + root.hdmi_stretch_w;
                height: 26px - root.hdmi_squash_h;
                border-radius: (26px - root.hdmi_squash_h) / 2;
                clip: true;
                opacity: (root.active_zone == "inputs") ? 1.0 : 0.0;

                animate opacity { duration: 160ms; easing: ease-out; }

                // 1. Co-located Optical Refracted Wallpaper
                Image {
                    x: -(((root.current_layout == "List") ? 530px : (root.width - 392px) / 2) + (root.anim_hdmi_x - root.hdmi_stretch_w * 0.5));
                    y: -(((root.current_layout == "List") ? 330px : 294px) + 3px + root.hdmi_squash_h * 0.5);
                    width: root.width;
                    height: root.height;
                    image-fit: cover;
                    source: root.dynamic_frost_image;
                }

                // 2. Optical Glass Tone Lift (Pure Clear Glass, NO Color Tint)
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: rgba(255, 255, 255, 0.02);
                }

                // 3. Convex Sheen
                Rectangle {
                    x: 3px;
                    y: 1px;
                    width: parent.width - 6px;
                    height: parent.height * 0.45;
                    border-radius: parent.border-radius - 1px;
                    background: @linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.0) 100%);
                }

                // 4. Specular Hairline Glint (no painted perimeter stroke border)
                Rectangle {
                    x: 6px;
                    y: 1px;
                    width: parent.width - 12px;
                    height: 1px;
                    border-radius: 0.5px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.35) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            // Segments inside the tray
            for hdmi[h_idx] in root.inputs: Rectangle {
                x: (h_idx == 0) ? 5px :
                   (h_idx == 1) ? 139px :
                   (h_idx == 2) ? 221px : 303px;
                y: 3px;
                width: (h_idx == 0) ? 130px :
                       (h_idx == 1) ? 78px :
                       (h_idx == 2) ? 78px : 84px;
                height: 26px;
                border-radius: 13px;

                // LiveTV Icon - vertically centered
                Image {
                    x: 8px;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                    source: @image-url("assets/icons/livetv.svg");
                    colorize: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : rgba(255, 255, 255, 0.88);

                    animate y, width, height { duration: 220ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                }

                // HDMI Label - vertically centered with room for connected dot
                Text {
                    x: 25px;
                    y: 0px;
                    width: parent.width - 25px - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: hdmi.label;
                    font-size: 11px;
                    font-weight: (root.active_zone == "inputs" && root.selected_input == h_idx) ? 600 : 500;
                    color: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : #f6f1e7;
                    overflow: elide;
                }

                // Status Dot - vertically centered
                if hdmi.connected: Rectangle {
                    x: parent.width - 15px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: rgba(52, 199, 89, 0.28);
                }
                Rectangle {
                    x: parent.width - 13px;
                    y: (parent.height - 6px) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: hdmi.connected ? #34C759 : rgba(255, 255, 255, 0.28);
                }
            }
        }

        // ==========================================
        // --- UTILITIES CONTROLS ---
        // ==========================================
        // List mode: Right-aligned vertical column
        if root.current_layout == "List": Rectangle {
            x: root.width - 180px - 56px;
            y: 376px;
            width: 180px;
            height: 140px;

            // Continuous Sliding Focus Pill (Morphing)
            Rectangle {
                x: 0px;
                y: root.anim_util_x; // in list mode, selected_util * 32px
                width: 180px;
                height: 28px;
                border-radius: 14px;
                opacity: (root.active_zone == "util") ? 1.0 : 0.0;
                background: @linear-gradient(165deg, rgba(255, 255, 255, 0.40) 0%, rgba(255, 255, 255, 0.18) 100%);

                animate y { duration: 240ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                animate opacity { duration: 160ms; }
            }

            for u[u_idx] in root.utils: Rectangle {
                y: u_idx * 32px;
                width: 180px;
                height: 28px;
                border-radius: 14px;

                Text {
                    x: 0px;
                    y: 5px;
                    width: 148px;
                    horizontal-alignment: right;
                    text: u;
                    font-size: 15px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 400;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(255, 255, 255, 0.85);
                }

                Image {
                    x: 156px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/quickpanel.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(255, 255, 255, 0.85);
                }
            }
        }

        // Dock mode: Top-Right Floating Glass Island Capsule
        if root.current_layout == "Dock": Rectangle {
            x: root.width - 396px;
            y: 36px;
            width: 340px;
            height: 32px;

            // Glass Island Body
            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 16px;
                frost_image: root.dynamic_frost_image;
                origin_x: root.width - 396px;
                origin_y: 36px;
                glass_tint: (root.current_material == "Tinted") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.28) 0%, rgba(0, 136, 255, 0.25) 30%, rgba(0, 68, 160, 0.55) 100%) :
                    (root.current_material == "Obsidian Tint") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.12) 0%, rgba(10, 14, 20, 0.78) 100%) :
                    (root.current_material == "Frost") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.28) 0%, rgba(20, 26, 34, 0.55) 30%, rgba(12, 16, 22, 0.68) 100%) :
                    (root.current_material == "Clear") ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.10) 0%, rgba(12, 16, 22, 0.35) 100%) :
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.22) 0%, rgba(16, 20, 28, 0.58) 100%);
                rim_color: rgba(255, 255, 255, 0.32);
                rim_width: 1px;
                show_specular_hairline: true;
                show_left_rim: false;
            }

            // Liquid Glass Selection Pill (Morphing & Jiggling - Pure Liquid Lens)
            Rectangle {
                x: root.anim_util_x - root.util_stretch_w * 0.5;
                y: 3px + root.util_squash_h * 0.5;
                width: root.anim_util_w + root.util_stretch_w;
                height: 26px - root.util_squash_h;
                border-radius: (26px - root.util_squash_h) / 2;
                clip: true;
                opacity: (root.active_zone == "util") ? 1.0 : 0.0;

                animate opacity { duration: 160ms; easing: ease-out; }

                // 1. Co-located Optical Refracted Wallpaper
                Image {
                    x: -((root.width - 396px) + (root.anim_util_x - root.util_stretch_w * 0.5));
                    y: -(39px + root.util_squash_h * 0.5);
                    width: root.width;
                    height: root.height;
                    image-fit: cover;
                    source: root.dynamic_frost_image;
                }

                // 2. Optical Glass Tone Lift (Pure Clear Glass, NO Color Tint)
                Rectangle {
                    width: 100%;
                    height: 100%;
                    background: rgba(255, 255, 255, 0.02);
                }

                // 3. Convex Sheen
                Rectangle {
                    x: 3px;
                    y: 1px;
                    width: parent.width - 6px;
                    height: parent.height * 0.45;
                    border-radius: parent.border-radius - 1px;
                    background: @linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.0) 100%);
                }

                // 4. Specular Hairline Glint (no painted perimeter stroke border)
                Rectangle {
                    x: 6px;
                    y: 1px;
                    width: parent.width - 12px;
                    height: 1px;
                    border-radius: 0.5px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.35) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            for u[u_idx] in root.utils: Rectangle {
                x: (u_idx == 0) ? 4px :
                   (u_idx == 1) ? 94px :
                   (u_idx == 2) ? 174px : 252px;
                y: 3px;
                width: (u_idx == 0) ? 86px :
                       (u_idx == 1) ? 76px :
                       (u_idx == 2) ? 74px : 80px;
                height: 26px;
                border-radius: 13px;

                Image {
                    x: 8px;
                    y: (parent.height - 14px) / 2;
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/livetv.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.90);

                    animate y, width, height { duration: 220ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1.0); }
                }

                Text {
                    x: 26px;
                    y: 0px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: u;
                    font-size: 11px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 500;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : #f6f1e7;
                }
            }
        }

        // ==========================================
        // --- NOW PLAYING MUSIC BAR ---
        // ==========================================
        if (root.now_playing_visible): Rectangle {
            x: (root.current_layout == "List") ? 540px : (root.width - 230px) / 2;
            y: (root.current_layout == "List") ? 284px : 252px;
            width: 230px;
            height: 36px;

            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 18px;
                frost_image: root.dynamic_frost_image;
                origin_x: (root.current_layout == "List") ? 540px : (root.width - 230px) / 2;
                origin_y: (root.current_layout == "List") ? 284px : 252px;
                glass_tint: (root.active_zone == "media") ?
                    @linear-gradient(170deg, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.16) 58%, rgba(255, 255, 255, 0.22) 100%) :
                    @linear-gradient(180deg, rgba(18, 22, 25, 0.75) 0%, rgba(12, 16, 20, 0.80) 100%);
                rim_color: (root.active_zone == "media") ? rgba(255, 255, 255, 0.35) : rgba(255, 255, 255, 0.18);
                rim_width: 1px;
                show_specular_hairline: true;
                show_left_rim: false;
            }

            // Music note icon
            Image {
                x: 10px;
                y: 10px;
                width: 16px;
                height: 16px;
                image-fit: contain;
                source: @image-url("assets/icons/applemusic.svg");
                colorize: #ffffff;
            }

            // Track & Artist text
            Text {
                x: 32px;
                y: 5px;
                width: 160px;
                text: root.now_playing_title;
                font-size: 11px;
                font-weight: 600;
                color: #ffffff;
                overflow: elide;
            }

            Text {
                x: 32px;
                y: 19px;
                width: 160px;
                text: root.now_playing_artist;
                font-size: 9px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.70);
                overflow: elide;
            }

            // Play / Pause glyph
            Text {
                x: parent.width - 20px;
                y: 11px;
                text: root.now_playing_playing ? "❚❚" : "▶";
                font-size: 11px;
                color: #ffffff;
            }
        }
    }

    // ==========================================
    // 4. ART MODE OVERLAY (Ambient Gallery View)
    // ==========================================
    if root.art_mode: Rectangle {
        width: 100%;
        height: 100%;

        // Ambient Floating Plaque (Liquid Frosted Glass)
        Rectangle {
            x: 56px;
            y: root.height - 130px;
            width: 440px;
            height: 80px;

            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 20px;
                frost_image: root.dynamic_frost_image;
                origin_x: 56px;
                origin_y: root.height - 130px;
                glass_tint: @linear-gradient(145deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 35%, rgba(18, 22, 28, 0.58) 70%, rgba(10, 14, 18, 0.78) 100%);
                rim_color: rgba(255, 255, 255, 0.28);
                rim_width: 1.2px;
                show_specular_hairline: true;
                show_left_rim: true;
            }

            Text {
                x: 20px;
                y: 12px;
                text: root.art_title;
                font-size: 20px;
                font-weight: 600;
                color: #ffffff;
            }

            Text {
                x: 20px;
                y: 36px;
                text: root.art_artist;
                font-size: 12px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.75);
            }

            Text {
                x: 20px;
                y: 56px;
                text: "‹ › Browse  ·  OK Set as wallpaper  ·  Back Exit";
                font-size: 10px;
                font-weight: 500;
                color: rgba(246, 241, 231, 0.50);
            }

            // Confirmation chip when wallpaper is set
            if root.art_saved_notice: Rectangle {
                x: parent.width - 130px;
                y: 14px;
                width: 116px;
                height: 24px;
                border-radius: 12px;
                background: #10b981;

                Text {
                    x: 0px;
                    y: 4px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "✓ Wallpaper Set";
                    font-size: 11px;
                    font-weight: 600;
                    color: #ffffff;
                }
            }
        }
    }

    // ==========================================
    // 5. MODAL SETTINGS SHEET (Side-by-Side with Live Dashboard Preview)
    // ==========================================
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(6, 10, 14, 0.45);

        // LEFT COLUMN: SETTINGS CONTROLS (Width 400px)
        Rectangle {
            x: 44px;
            y: 28px;
            width: 400px;
            height: 484px;

            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 20px;
                frost_image: root.dynamic_frost_image;
                origin_x: 44px;
                origin_y: 28px;
                glass_tint: @linear-gradient(155deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.05) 30%, rgba(14, 18, 24, 0.70) 60%, rgba(8, 12, 16, 0.88) 100%);
            }

            // LEVEL 0: SETTINGS OVERVIEW LIST
            if !root.settings_detail: Rectangle {
                width: 100%;
                height: 100%;

                // Title
                Text {
                    x: 24px;
                    y: 20px;
                    text: "Settings";
                    font-size: 24px;
                    font-weight: 600;
                    color: #ffffff;
                }

                // Clock Chip in Top-Right
                Rectangle {
                    x: parent.width - 92px;
                    y: 20px;
                    width: 68px;
                    height: 24px;
                    border-radius: 12px;
                    background: rgba(255, 255, 255, 0.12);

                    Text {
                        x: 0px;
                        y: 4px;
                        width: parent.width;
                        horizontal-alignment: center;
                        text: root.clock_text;
                        font-size: 13px;
                        font-weight: 500;
                        color: #ffffff;
                    }
                }

                // 10 Settings Categories List (Scrollable window)
                Rectangle {
                    x: 16px;
                    y: 56px;
                    width: parent.width - 32px;
                    height: 384px;
                    clip: true;

                    // Liquid Glass Selection Plate (Morphing & Jiggling - Pure Liquid Lens)
                    Rectangle {
                        x: root.setting_squash_w * 0.5;
                        y: root.anim_setting_y - root.setting_stretch_h * 0.5;
                        width: parent.width - root.setting_squash_w;
                        height: 58px + root.setting_stretch_h;
                        border-radius: 14px;
                        clip: true;

                        // 1. Co-located Optical Refracted Wallpaper
                        Image {
                            x: -(60px + root.setting_squash_w * 0.5);
                            y: -(84px + root.anim_setting_y - root.setting_stretch_h * 0.5);
                            width: root.width;
                            height: root.height;
                            image-fit: cover;
                            source: root.dynamic_frost_image;
                        }

                        // 2. Optical Glass Tone Lift (Pure Clear Glass, NO milky tint)
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: rgba(255, 255, 255, 0.12);
                        }

                        // 3. Convex Top Specular Sheen
                        Rectangle {
                            x: 4px;
                            y: 1px;
                            width: parent.width - 8px;
                            height: parent.height * 0.45;
                            border-radius: 12px;
                            background: @linear-gradient(180deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.0) 100%);
                        }

                        // 4. Specular Hairline Glint (zero stroke border)
                        Rectangle {
                            x: 8px;
                            y: 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.45) 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }

                    for s[s_idx] in root.settings_list: Rectangle {
                        x: 0px;
                        y: s_idx * 66px;
                        width: parent.width;
                        height: 58px;
                        border-radius: 14px;

                        animate y { duration: 240ms; easing: cubic-bezier(0.25, 1.25, 0.5, 1.0); }

                        // Label & Value
                        Text {
                            x: 16px;
                            y: 10px;
                            height: 18px;
                            vertical-alignment: center;
                            text: s.label;
                            font-size: 14px;
                            font-weight: 600;
                            color: #ffffff;
                        }

                        Text {
                            x: 16px;
                            y: 30px;
                            height: 16px;
                            vertical-alignment: center;
                            text: s.value;
                            font-size: 11px;
                            font-weight: 400;
                            color: (root.selected_setting == s_idx) ? rgba(255, 255, 255, 0.95) : rgba(246, 241, 231, 0.70);
                        }

                        Text {
                            x: parent.width - 28px;
                            y: 0px;
                            width: 16px;
                            height: parent.height;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: "›";
                            font-size: 18px;
                            font-weight: 600;
                            color: (root.selected_setting == s_idx) ? #ffffff : rgba(246, 241, 231, 0.40);
                        }
                    }
                }

                // Bottom Hint
                Rectangle {
                    x: 24px;
                    y: parent.height - 34px;
                    width: parent.width - 48px;
                    height: 24px;

                    Rectangle {
                        x: 0px;
                        y: 1px;
                        width: 28px;
                        height: 20px;
                        border-radius: 10px;
                        background: rgba(255, 255, 255, 0.22);

                        Text {
                            x: 0px;
                            y: 3px;
                            width: parent.width;
                            horizontal-alignment: center;
                            text: "OK";
                            font-size: 10px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                    }

                    Text {
                        x: 36px;
                        y: 4px;
                        text: "Open · Back Exit";
                        font-size: 11px;
                        font-weight: 500;
                        color: rgba(246, 241, 231, 0.65);
                    }
                }
            }

            // LEVEL 1: DETAIL SUBMENU OPTIONS
            if root.settings_detail: Rectangle {
                width: 100%;
                height: 100%;

                // Back Button (Pure Liquid Glass Capsule)
                Rectangle {
                    x: 20px;
                    y: 16px;
                    width: 170px;
                    height: 26px;
                    border-radius: 13px;
                    clip: true;

                    // Co-located Frosted Wallpaper
                    Image {
                        x: -64px;
                        y: -44px;
                        width: root.width;
                        height: root.height;
                        image-fit: cover;
                        source: root.dynamic_frost_image;
                    }

                    // Optical Tone Lift
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: (root.selected_detail_option == -1) ?
                            rgba(255, 255, 255, 0.22) :
                            rgba(255, 255, 255, 0.08);
                    }

                    // Top Sheen
                    if (root.selected_detail_option == -1): Rectangle {
                        x: 2px;
                        y: 1px;
                        width: parent.width - 4px;
                        height: parent.height * 0.45;
                        border-radius: 11px;
                        background: @linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.0) 100%);
                    }

                    Text {
                        x: 8px;
                        y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: root.detail_back_text;
                        font-size: 11px;
                        font-weight: 600;
                        color: #ffffff;
                    }
                }

                // Submenu Title
                Text {
                    x: 24px;
                    y: 48px;
                    text: root.detail_title;
                    font-size: 20px;
                    font-weight: 600;
                    color: #ffffff;
                }

                // Submenu Description
                Text {
                    x: 24px;
                    y: 74px;
                    width: parent.width - 48px;
                    text: root.detail_desc;
                    font-size: 11px;
                    font-weight: 400;
                    color: rgba(246, 241, 231, 0.70);
                    wrap: word-wrap;
                }

                // Options List (Scrollable)
                Rectangle {
                    x: 16px;
                    y: 106px;
                    width: parent.width - 32px;
                    height: 336px;
                    clip: true;

                    // Liquid Glass Selection Plate (Morphing & Jiggling - Pure Liquid Lens)
                    if (root.selected_detail_option >= 0): Rectangle {
                        x: root.detail_squash_w * 0.5;
                        y: root.anim_detail_y - root.detail_stretch_h * 0.5;
                        width: parent.width - root.detail_squash_w;
                        height: 40px + root.detail_stretch_h;
                        border-radius: 10px;
                        clip: true;

                        // 1. Co-located Optical Refracted Wallpaper
                        Image {
                            x: -(60px + root.detail_squash_w * 0.5);
                            y: -(134px + root.anim_detail_y - root.detail_stretch_h * 0.5);
                            width: root.width;
                            height: root.height;
                            image-fit: cover;
                            source: root.dynamic_frost_image;
                        }

                        // 2. Optical Glass Tone Lift (Pure Clear Glass, NO milky tint)
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: root.in_appearance_panel ? rgba(255, 255, 255, 0.05) : rgba(255, 255, 255, 0.14);
                        }

                        // 3. Convex Top Specular Sheen
                        Rectangle {
                            x: 4px;
                            y: 1px;
                            width: parent.width - 8px;
                            height: parent.height * 0.45;
                            border-radius: 8px;
                            background: @linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.0) 100%);
                        }

                        // 4. Specular Hairline Glint (zero stroke border)
                        Rectangle {
                            x: 8px;
                            y: 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            border-radius: 0.5px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.45) 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }

                    for opt[o_idx] in root.detail_options: Rectangle {
                        x: 0px;
                        y: (o_idx * 44px) - ((root.selected_detail_option > 5) ? (root.selected_detail_option - 5) * 44px : 0px);
                        width: parent.width;
                        height: 40px;
                        border-radius: 10px;

                        animate y { duration: 240ms; easing: cubic-bezier(0.25, 1.25, 0.5, 1.0); }

                        // Radio indicator dot
                        if (opt.id != "refraction" && opt.id != "transparency" && opt.id != "nav_focus_item" && opt.id != "nav_dock_settings" && opt.id != "nav_bg" && opt.id != "nav_font" && opt.id != "nav_inputs" && opt.id != "nav_apps" && opt.id != "nav_tv"): Rectangle {
                            x: 12px;
                            y: (parent.height - 10px) / 2;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: opt.active ? #34C759 : rgba(255, 255, 255, 0.25);
                        }

                        // Slider dot
                        if (opt.id == "refraction" || opt.id == "transparency"): Rectangle {
                            x: 12px;
                            y: (parent.height - 10px) / 2;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: (opt.id == "refraction") ? #0088FF : #34C759;
                        }

                        // Option Title & Description
                        Text {
                            x: (opt.id == "nav_focus_item" || opt.id == "nav_dock_settings" || opt.id == "nav_bg" || opt.id == "nav_font" || opt.id == "nav_inputs" || opt.id == "nav_apps" || opt.id == "nav_tv") ? 16px : 30px;
                            y: 3px;
                            height: 16px;
                            vertical-alignment: center;
                            text: opt.title;
                            font-size: 12px;
                            font-weight: 600;
                            color: #ffffff;
                        }

                        Text {
                            x: (opt.id == "nav_focus_item" || opt.id == "nav_dock_settings" || opt.id == "nav_bg" || opt.id == "nav_font" || opt.id == "nav_inputs" || opt.id == "nav_apps" || opt.id == "nav_tv") ? 16px : 30px;
                            y: 19px;
                            height: 16px;
                            vertical-alignment: center;
                            text: opt.desc;
                            font-size: 10px;
                            font-weight: 400;
                            color: (root.selected_detail_option == o_idx) ? rgba(255, 255, 255, 0.95) : rgba(246, 241, 231, 0.70);
                        }

                        // Chevron for navigation items
                        if (opt.id == "nav_focus_item" || opt.id == "nav_dock_settings" || opt.id == "nav_bg" || opt.id == "nav_font" || opt.id == "nav_inputs" || opt.id == "nav_apps" || opt.id == "nav_tv"): Text {
                            x: parent.width - 24px;
                            y: 0px;
                            width: 16px;
                            height: parent.height;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: "›";
                            font-size: 18px;
                            font-weight: 600;
                            color: (root.selected_detail_option == o_idx) ? #ffffff : rgba(246, 241, 231, 0.40);
                        }

                        // Trailing mini-slider track for refraction / transparency sliders
                        if (opt.id == "refraction"): Rectangle {
                            x: parent.width - 70px;
                            y: (parent.height - 6px) / 2;
                            width: 56px;
                            height: 6px;
                            border-radius: 3px;
                            background: rgba(255, 255, 255, 0.20);

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: clamp(parent.width * root.refraction_value, 4px, parent.width);
                                height: 100%;
                                border-radius: 3px;
                                background: #0088FF;
                            }
                        }

                        if (opt.id == "transparency"): Rectangle {
                            x: parent.width - 70px;
                            y: (parent.height - 6px) / 2;
                            width: 56px;
                            height: 6px;
                            border-radius: 3px;
                            background: rgba(255, 255, 255, 0.20);

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: clamp(parent.width * root.transparency_value, 4px, parent.width);
                                height: 100%;
                                border-radius: 3px;
                                background: #34C759;
                            }
                        }
                    }
                }

                // Bottom Hint
                Rectangle {
                    x: 24px;
                    y: parent.height - 34px;
                    width: parent.width - 48px;
                    height: 24px;

                    Rectangle {
                        x: 0px;
                        y: 1px;
                        width: 28px;
                        height: 20px;
                        border-radius: 10px;
                        background: rgba(255, 255, 255, 0.22);

                        Text {
                            x: 0px;
                            y: 3px;
                            width: parent.width;
                            horizontal-alignment: center;
                            text: "OK";
                            font-size: 10px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                    }

                    Text {
                        x: 36px;
                        y: 4px;
                        text: "OK Select / Toggle  ·  Left / Right Adjust  ·  Back Return";
                        font-size: 11px;
                        font-weight: 500;
                        color: rgba(246, 241, 231, 0.65);
                    }
                }
            }
        }

        // RIGHT COLUMN: LIVE INTERACTIVE DASHBOARD PREVIEW
        Rectangle {
            x: 462px;
            y: 28px;
            width: 456px;
            height: 484px;

            // Liquid Glass Substrate Mat
            LiquidGlassPanel {
                width: 100%;
                height: 100%;
                border-radius: 20px;
                frost_image: root.dynamic_frost_image;
                origin_x: 462px;
                origin_y: 28px;
                glass_tint: (root.current_material == "Tinted") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.28) 0%, rgba(0, 136, 255, 0.25) 25%, rgba(0, 68, 160, 0.45) 70%, rgba(6, 12, 24, 0.65) 100%) :
                    (root.current_material == "Obsidian Tint") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.12) 0%, rgba(14, 18, 26, 0.72) 25%, rgba(6, 10, 16, 0.88) 100%) :
                    (root.current_material == "Frost") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.08) 22%, rgba(18, 24, 32, 0.48) 60%, rgba(10, 14, 20, 0.68) 100%) :
                    (root.current_material == "Clear") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.01) 25%, rgba(12, 16, 22, 0.25) 100%) :
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.06) 25%, rgba(18, 22, 28, 0.45) 65%, rgba(10, 14, 18, 0.62) 100%);
                rim_color: rgba(255, 255, 255, 0.34);
                rim_width: 1.25px;
                show_specular_hairline: true;
                show_left_rim: false;
            }

            // Panel Content
            Rectangle {
                width: 100%;
                height: 100%;

                // 1. Header & Subtitle
                Text {
                    x: 20px;
                    y: 18px;
                    text: "Live Preview";
                    font-size: 20px;
                    font-weight: 700;
                    color: #ffffff;
                }
                Text {
                    x: 20px;
                    y: 44px;
                    text: "Real-time Home Screen & Optical Glass Simulation";
                    font-size: 12px;
                    font-weight: 400;
                    color: rgba(255, 255, 255, 0.65);
                }

                // 2. Miniature Home Screen Preview Stage (16:9 Aspect Ratio)
                Rectangle {
                    x: 20px;
                    y: 68px;
                    width: 416px;
                    height: 234px;
                    border-radius: 14px;
                    clip: true;

                    // Photographic Wallpaper Background
                    Image {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                        source: (root.wallpaper_idx == 0) ? @image-url("assets/wallpapers/misty.jpg") :
                                (root.wallpaper_idx == 1) ? @image-url("assets/wallpapers/cove.jpg") :
                                (root.wallpaper_idx == 2) ? @image-url("assets/wallpapers/forest.jpg") :
                                (root.wallpaper_idx == 3) ? @image-url("assets/wallpapers/valley.jpg") :
                                (root.wallpaper_idx == 4) ? @image-url("assets/wallpapers/night.jpg") :
                                (root.wallpaper_idx == 5) ? @image-url("assets/wallpapers/peaks.jpg") :
                                (root.wallpaper_idx == 6) ? @image-url("assets/wallpapers/bridge.jpg") :
                                (root.wallpaper_idx == 7) ? @image-url("assets/wallpapers/ridge.jpg") :
                                (root.wallpaper_idx == 8) ? @image-url("assets/wallpapers/golden.jpg") :
                                (root.wallpaper_idx == 9) ? @image-url("assets/wallpapers/summit.jpg") :
                                (root.wallpaper_idx == 10) ? @image-url("assets/wallpapers/goldcoast.jpg") :
                                (root.wallpaper_idx == 11) ? @image-url("assets/wallpapers/sydney.jpg") :
                                (root.wallpaper_idx == 12) ? @image-url("assets/wallpapers/amber.jpg") :
                                (root.wallpaper_idx == 13) ? @image-url("assets/wallpapers/mint.jpg") :
                                @image-url("assets/wallpapers/alpine.jpg");
                    }

                    // Mini Clock & Caption
                    Text {
                        x: 14px;
                        y: 10px;
                        text: root.clock_text;
                        font-size: 14px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    Text {
                        x: 14px;
                        y: 28px;
                        text: root.focused_caption;
                        font-size: 8px;
                        font-weight: 500;
                        color: rgba(255, 255, 255, 0.85);
                    }

                    // Mini Utilities Pill
                    Rectangle {
                        x: parent.width - 156px;
                        y: 10px;
                        width: 142px;
                        height: 18px;
                        border-radius: 9px;
                        background: rgba(255, 255, 255, 0.14);
                        clip: true;

                        Text {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: "Art Mode · All apps · Inputs · Settings";
                            font-size: 6.5px;
                            font-weight: 500;
                            color: rgba(255, 255, 255, 0.90);
                        }
                    }

                    // Mini HDMI Pill
                    Rectangle {
                        x: (parent.width - 164px) / 2;
                        y: 122px;
                        width: 164px;
                        height: 16px;
                        border-radius: 8px;
                        background: rgba(255, 255, 255, 0.12);
                        clip: true;

                        Text {
                            width: 100%;
                            height: 100%;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: "HDMI 1 · Mac   HDMI 2   HDMI 3   AV";
                            font-size: 7.5px;
                            font-weight: 500;
                            color: rgba(255, 255, 255, 0.85);
                        }
                    }

                    // Mini Dock (Carousel)
                    if (root.current_layout == "Dock"): Rectangle {
                        x: (parent.width - 320px) / 2;
                        y: 146px;
                        width: 320px;
                        height: 64px;
                        border-radius: 16px;
                        clip: true;

                        // Co-located blurred wallpaper substrate
                        Image {
                            x: -((parent.width - 320px) / 2);
                            y: -146px;
                            width: 416px;
                            height: 234px;
                            image-fit: cover;
                            source: root.dock_frost_image;
                        }

                        // Translucent tint
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: (root.current_material == "Tinted") ?
                                @linear-gradient(155deg, rgba(255, 255, 255, 0.28) 0%, rgba(0, 136, 255, 0.25) 25%, rgba(0, 68, 160, 0.45) 70%, rgba(6, 12, 24, 0.65) 100%) :
                                (root.current_material == "Obsidian Tint") ?
                                @linear-gradient(155deg, rgba(255, 255, 255, 0.12) 0%, rgba(14, 18, 26, 0.72) 25%, rgba(6, 10, 16, 0.88) 100%) :
                                (root.current_material == "Clear") ?
                                @linear-gradient(155deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.01) 25%, rgba(12, 16, 22, 0.25) 100%) :
                                @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.06) 25%, rgba(18, 22, 28, 0.45) 65%, rgba(10, 14, 18, 0.62) 100%);
                        }

                        // Live Focus Item Lens on Focused Preview App (index 2)
                        if (root.current_focus_style == "Glass Plate"): Rectangle {
                            x: 4px + 2 * 62px;
                            y: 4px;
                            width: 60px;
                            height: 56px;
                            border-radius: 12px;
                            clip: true;

                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.focus_lens_image;
                            }
                        }

                        if (root.current_focus_style == "Round"): Rectangle {
                            x: 4px + 2 * 62px + (60px - 52px) / 2;
                            y: 6px;
                            width: 52px;
                            height: 52px;
                            border-radius: 26px;
                            clip: true;

                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.round_focus_lens_image;
                            }
                        }

                        // App items preview
                        for app[i] in root.apps: Rectangle {
                            if (i < 5): Rectangle {
                                x: 4px + i * 62px;
                                y: 4px;
                                width: 60px;
                                height: 56px;

                                if (!root.is_custom_icon_pack): Image {
                                    x: (parent.width - 22px) / 2;
                                    y: 8px;
                                    width: 22px;
                                    height: 22px;
                                    image-fit: contain;
                                    colorize: (root.current_icon_pack == "Full Color") ? app.brand_color : #ffffff;
                                    source: app.icon;
                                }
                                if (root.is_custom_icon_pack): Image {
                                    x: (parent.width - 22px) / 2;
                                    y: 8px;
                                    width: 22px;
                                    height: 22px;
                                    image-fit: contain;
                                    source: app.icon;
                                }

                                Text {
                                    x: 0px;
                                    y: 34px;
                                    width: parent.width;
                                    horizontal-alignment: center;
                                    text: app.name;
                                    font-size: 8px;
                                    font-weight: (i == 2) ? 700 : 500;
                                    color: (i == 2) ? #ffffff : rgba(255, 255, 255, 0.75);
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Mini List (Vertical Column)
                    if (root.current_layout == "List"): Rectangle {
                        x: 20px;
                        y: 48px;
                        width: 160px;
                        height: 170px;

                        for app[i] in root.apps: Rectangle {
                            if (i < 6): Rectangle {
                                y: i * 26px;
                                width: 150px;
                                height: 22px;
                                border-radius: 6px;

                                if (i == 2): Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: 6px;
                                    background: rgba(255, 255, 255, 0.22);
                                }

                                if (!root.is_custom_icon_pack): Image {
                                    x: 6px;
                                    y: 3px;
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                    colorize: (root.current_icon_pack == "Full Color") ? app.brand_color : #ffffff;
                                    source: app.icon;
                                }
                                if (root.is_custom_icon_pack): Image {
                                    x: 6px;
                                    y: 3px;
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                    source: app.icon;
                                }

                                Text {
                                    x: 28px;
                                    y: 3px;
                                    text: app.name;
                                    font-size: 9px;
                                    font-weight: (i == 2) ? 700 : 500;
                                    color: #ffffff;
                                }
                            }
                        }
                    }

                    // Stage border outline
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.22);
                    }
                }

                // 3. Liquid Glass Live Optics Status Readout Card
                Rectangle {
                    x: 20px;
                    y: 312px;
                    width: 416px;
                    height: 116px;
                    border-radius: 14px;
                    background: rgba(0, 0, 0, 0.28);
                    border-width: 0.75px;
                    border-color: rgba(255, 255, 255, 0.16);

                    Rectangle {
                        x: 16px;
                        y: 14px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #34C759;
                    }

                    Text {
                        x: 32px;
                        y: 10px;
                        text: "Optical Simulation Active";
                        font-size: 11px;
                        font-weight: 700;
                        color: #ffffff;
                    }

                    Text {
                        x: 16px;
                        y: 32px;
                        text: "• Snell Refraction: " + root.refraction_display + "  (η = 1.50, depth " + Math.round(12.0 + 40.0 * root.refraction_value) + "pt)";
                        font-size: 10px;
                        font-weight: 500;
                        color: rgba(255, 255, 255, 0.85);
                    }

                    Text {
                        x: 16px;
                        y: 52px;
                        text: "• Focus Style: " + root.current_focus_style + "  ·  Material: " + root.appearance_preset + " Glass";
                        font-size: 10px;
                        font-weight: 500;
                        color: rgba(255, 255, 255, 0.85);
                    }

                    Text {
                        x: 16px;
                        y: 72px;
                        text: "• Dock Layout: " + root.current_layout + "  ·  Icon Pack: " + root.current_icon_pack;
                        font-size: 10px;
                        font-weight: 500;
                        color: rgba(255, 255, 255, 0.85);
                    }

                    Text {
                        x: 16px;
                        y: 92px;
                        text: "• Performance: 60 FPS Native  ·  Zero-Latency Decoupled Pipeline";
                        font-size: 10px;
                        font-weight: 600;
                        color: #0088FF;
                    }
                }

                // 4. Remote D-Pad Guidance Footer
                Text {
                    x: 20px;
                    y: 452px;
                    width: parent.width - 40px;
                    horizontal-alignment: center;
                    text: "Left / Right Adjust Sliders  ·  OK Select / Toggle  ·  Back Return";
                    font-size: 11px;
                    font-weight: 600;
                    color: rgba(255, 255, 255, 0.70);
                }
            }
        }
    }

    // ==========================================
    // 6. ALL APPLICATIONS STUDIO (Apple Liquid Glass)
    // ==========================================
    if root.all_apps_open: Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(6, 10, 14, 0.45);

        Rectangle {
            x: 32px;
            y: 28px;
            width: root.width - 64px;
            height: root.height - 56px;
            border-radius: 24px;
            clip: true;

            // 1. Refracted Wallpaper Substrate
            Image {
                x: -(32px);
                y: -(28px);
                width: root.width;
                height: root.height;
                image-fit: cover;
                source: root.dynamic_frost_image;
            }

            // 2. Liquid Glass Substrate Tint (matching liquid-rust)
            Rectangle {
                width: 100%;
                height: 100%;
                background: (root.current_material == "Obsidian Tint") ?
                    @linear-gradient(155deg, rgba(20, 26, 38, 0.94) 0%, rgba(10, 14, 20, 0.97) 100%) :
                    (root.current_material == "Clear") ?
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 28%, rgba(16, 20, 28, 0.72) 75%, rgba(10, 14, 18, 0.88) 100%) :
                    @linear-gradient(155deg, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.08) 28%, rgba(22, 28, 38, 0.78) 75%, rgba(12, 16, 24, 0.92) 100%);
            }

            // 3. Specular Top Rim Glint
            Rectangle {
                x: 16px;
                y: 1px;
                width: parent.width - 32px;
                height: 1.5px;
                background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.85) 50%, rgba(255, 255, 255, 0.0) 100%);
            }

            // Outer Perimeter Hairline
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 24px;
                border-width: 0.75px;
                border-color: rgba(255, 255, 255, 0.22);
            }

            // 4. Header Bar
            Rectangle {
                x: 28px;
                y: 18px;
                width: parent.width - 56px;
                height: 48px;

                Text {
                    x: 0px;
                    y: 2px;
                    text: "All Applications";
                    font-size: 20px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Text {
                    x: 0px;
                    y: 28px;
                    text: "Installed TV applications & streaming services · OK: Select Actions · Back: Return Home";
                    font-size: 11.5px;
                    font-weight: 400;
                    color: rgba(255, 255, 255, 0.65);
                }

                // Stats Capsule
                Rectangle {
                    x: parent.width - 160px;
                    y: 6px;
                    width: 160px;
                    height: 28px;
                    border-radius: 14px;
                    background: rgba(120, 120, 128, 0.25);
                    border-width: 0.75px;
                    border-color: rgba(255, 255, 255, 0.20);

                    Text {
                        width: 100%;
                        height: 100%;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        text: root.apps.length + " Docked · " + root.all_apps_list.length + " Total";
                        font-size: 11px;
                        font-weight: 600;
                        color: #ffffff;
                    }
                }
            }

            // 5. Apps Grid (4 Columns, Scrollable Window)
            Rectangle {
                x: 28px;
                y: 74px;
                width: parent.width - 56px;
                height: 350px;
                clip: true;

                Rectangle {
                    x: 0px;
                    y: -clamp((Math.floor(root.selected_all_app / 4) - 1) * 78px, 0px, 1200px);
                    width: 100%;
                    height: (Math.ceil(root.all_apps_list.length / 4) + 1) * 78px;

                    animate y { duration: 250ms; easing: cubic-bezier(0.25, 1.25, 0.5, 1.0); }

                    for app[i] in root.all_apps_list: Rectangle {
                        x: Math.mod(i, 4) * 212px;
                        y: Math.floor(i / 4) * 78px;
                        width: 200px;
                        height: 68px;
                        border-radius: 16px;
                        clip: true;

                        // Card Background
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 16px;
                            background: (root.selected_all_app == i) ?
                                rgba(255, 255, 255, 0.18) :
                                rgba(255, 255, 255, 0.06);

                            animate background { duration: 150ms; }
                        }

                        // Focus Ring
                        if (root.selected_all_app == i): Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 16px;
                            border-width: 1.5px;
                            border-color: #ffffff;

                            // Specular Top Glint
                            Rectangle {
                                x: 6px;
                                y: 1px;
                                width: parent.width - 12px;
                                height: 1.25px;
                                background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.95) 50%, rgba(255, 255, 255, 0.0) 100%);
                            }
                        }

                        // App Brand Icon
                        if (!root.is_custom_icon_pack): Image {
                            x: 12px;
                            y: (parent.height - 32px) / 2;
                            width: 32px;
                            height: 32px;
                            image-fit: contain;
                            source: app.icon;
                            colorize: (root.current_icon_pack == "Full Color") ?
                                app.brand_color :
                                #ffffff;
                        }
                        if (root.is_custom_icon_pack): Image {
                            x: 12px;
                            y: (parent.height - 32px) / 2;
                            width: 32px;
                            height: 32px;
                            image-fit: contain;
                            source: app.icon;
                        }

                        // App Name
                        Text {
                            x: 52px;
                            y: 14px;
                            width: parent.width - 105px;
                            text: app.name;
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            overflow: elide;
                        }

                        // App Package / Status
                        Text {
                            x: 52px;
                            y: 35px;
                            width: parent.width - 105px;
                            text: app.pkg;
                            font-size: 9.5px;
                            font-weight: 400;
                            color: rgba(255, 255, 255, 0.55);
                            overflow: elide;
                        }

                        // Dock Indicator Badge
                        Rectangle {
                            x: parent.width - 48px;
                            y: (parent.height - 20px) / 2;
                            width: 40px;
                            height: 20px;
                            border-radius: 10px;
                            background: app.in_dock ?
                                #0088FF :
                                rgba(120, 120, 128, 0.28);

                            Text {
                                width: 100%;
                                height: 100%;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                text: app.in_dock ? "★ Dock" : "+ Add";
                                font-size: 8.5px;
                                font-weight: 700;
                                color: #ffffff;
                            }
                        }
                    }
                }
            }

            // 6. Navigation Hint Bar
            Text {
                x: 28px;
                y: 432px;
                width: parent.width - 56px;
                horizontal-alignment: center;
                text: "D-Pad: Navigate Grid  ·  OK: App Actions (Launch or Add/Remove from Dock)  ·  Back: Return Home";
                font-size: 10.5px;
                font-weight: 500;
                color: rgba(255, 255, 255, 0.60);
            }

            // ==========================================
            // ACTION MODAL POPOVER (Apple Liquid Glass Redesign)
            // ==========================================
            if root.all_apps_action_open: Rectangle {
                width: 100%;
                height: 100%;
                background: rgba(4, 8, 14, 0.60);

                Rectangle {
                    x: (parent.width - 380px) / 2;
                    y: (parent.height - 232px) / 2;
                    width: 380px;
                    height: 232px;

                    // Liquid Glass Substrate Panel
                    LiquidGlassPanel {
                        width: 100%;
                        height: 100%;
                        border-radius: 22px;
                        frost_image: root.dynamic_frost_image;
                        origin_x: (root.width - 380px) / 2;
                        origin_y: (root.height - 232px) / 2;
                        glass_tint: @linear-gradient(155deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.05) 28%, rgba(14, 18, 24, 0.72) 65%, rgba(8, 12, 16, 0.90) 100%);
                        rim_color: rgba(255, 255, 255, 0.35);
                        rim_width: 1.0px;
                        show_specular_hairline: true;
                    }

                    // App Header
                    Rectangle {
                        x: 20px;
                        y: 16px;
                        width: parent.width - 40px;
                        height: 48px;

                        // App Icon Badge
                        Rectangle {
                            x: 0px;
                            y: 2px;
                            width: 44px;
                            height: 44px;
                            border-radius: 12px;
                            background: rgba(255, 255, 255, 0.10);
                            clip: true;

                            // Specular Top Sheen
                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height * 0.45;
                                border-radius: 11px;
                                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.0) 100%);
                            }

                            if (!root.is_custom_icon_pack && root.selected_all_app < root.all_apps_list.length): Image {
                                x: 6px;
                                y: 6px;
                                width: 32px;
                                height: 32px;
                                image-fit: contain;
                                source: root.all_apps_list[root.selected_all_app].icon;
                                colorize: (root.current_icon_pack == "Full Color") ?
                                    root.all_apps_list[root.selected_all_app].brand_color :
                                    #ffffff;
                            }
                            if (root.is_custom_icon_pack && root.selected_all_app < root.all_apps_list.length): Image {
                                x: 6px;
                                y: 6px;
                                width: 32px;
                                height: 32px;
                                image-fit: contain;
                                source: root.all_apps_list[root.selected_all_app].icon;
                            }
                        }

                        // App Title & Package
                        if (root.selected_all_app < root.all_apps_list.length): Text {
                            x: 56px;
                            y: 4px;
                            width: parent.width - 150px;
                            text: root.all_apps_list[root.selected_all_app].name;
                            font-size: 15px;
                            font-weight: 700;
                            color: #ffffff;
                            overflow: elide;
                        }

                        if (root.selected_all_app < root.all_apps_list.length): Text {
                            x: 56px;
                            y: 26px;
                            width: parent.width - 150px;
                            text: root.all_apps_list[root.selected_all_app].pkg;
                            font-size: 10px;
                            font-weight: 400;
                            color: rgba(255, 255, 255, 0.60);
                            overflow: elide;
                        }

                        // Dock Status Pill (Top Right)
                        Rectangle {
                            x: parent.width - 86px;
                            y: 10px;
                            width: 86px;
                            height: 24px;
                            border-radius: 12px;
                            background: (root.selected_all_app < root.all_apps_list.length && root.all_apps_list[root.selected_all_app].in_dock) ?
                                rgba(52, 199, 89, 0.20) :
                                rgba(255, 255, 255, 0.10);

                            Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                text: (root.selected_all_app < root.all_apps_list.length && root.all_apps_list[root.selected_all_app].in_dock) ?
                                    "★ In Dock" :
                                    "Unpinned";
                                font-size: 10px;
                                font-weight: 600;
                                color: (root.selected_all_app < root.all_apps_list.length && root.all_apps_list[root.selected_all_app].in_dock) ?
                                    #34C759 :
                                    rgba(255, 255, 255, 0.65);
                            }
                        }
                    }

                    // Action 0: Launch App
                    Rectangle {
                        x: 20px;
                        y: 76px;
                        width: parent.width - 40px;
                        height: 46px;
                        border-radius: 13px;
                        clip: true;

                        // Focused Liquid Glass Selection
                        if (root.selected_all_app_action == 0): Rectangle {
                            width: 100%;
                            height: 100%;

                            Image {
                                x: -((root.width - 380px) / 2 + 20px);
                                y: -((root.height - 232px) / 2 + 76px);
                                width: root.width;
                                height: root.height;
                                image-fit: cover;
                                source: root.dynamic_frost_image;
                            }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: rgba(255, 255, 255, 0.16);
                            }

                            Rectangle {
                                x: 4px;
                                y: 1px;
                                width: parent.width - 8px;
                                height: parent.height * 0.45;
                                border-radius: 10px;
                                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.0) 100%);
                            }

                            Rectangle {
                                x: 8px;
                                y: 1px;
                                width: parent.width - 16px;
                                height: 1px;
                                background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.65) 50%, rgba(255, 255, 255, 0.0) 100%);
                            }
                        }

                        if (root.selected_all_app_action != 0): Rectangle {
                            width: 100%;
                            height: 100%;
                            background: rgba(255, 255, 255, 0.06);
                        }

                        Text {
                            x: 16px;
                            y: 0px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: "▶   Launch Application";
                            font-size: 13px;
                            font-weight: (root.selected_all_app_action == 0) ? 700 : 500;
                            color: #ffffff;
                        }

                        Text {
                            x: parent.width - 28px;
                            y: 0px;
                            width: 16px;
                            height: parent.height;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: "›";
                            font-size: 18px;
                            font-weight: 600;
                            color: (root.selected_all_app_action == 0) ? #ffffff : rgba(255, 255, 255, 0.35);
                        }
                    }

                    // Action 1: Toggle Dock
                    Rectangle {
                        x: 20px;
                        y: 130px;
                        width: parent.width - 40px;
                        height: 46px;
                        border-radius: 13px;
                        clip: true;

                        // Focused Liquid Glass Selection
                        if (root.selected_all_app_action == 1): Rectangle {
                            width: 100%;
                            height: 100%;

                            Image {
                                x: -((root.width - 380px) / 2 + 20px);
                                y: -((root.height - 232px) / 2 + 130px);
                                width: root.width;
                                height: root.height;
                                image-fit: cover;
                                source: root.dynamic_frost_image;
                            }

                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: rgba(255, 255, 255, 0.16);
                            }

                            Rectangle {
                                x: 4px;
                                y: 1px;
                                width: parent.width - 8px;
                                height: parent.height * 0.45;
                                border-radius: 10px;
                                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.0) 100%);
                            }

                            Rectangle {
                                x: 8px;
                                y: 1px;
                                width: parent.width - 16px;
                                height: 1px;
                                background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.65) 50%, rgba(255, 255, 255, 0.0) 100%);
                            }
                        }

                        if (root.selected_all_app_action != 1): Rectangle {
                            width: 100%;
                            height: 100%;
                            background: rgba(255, 255, 255, 0.06);
                        }

                        Text {
                            x: 16px;
                            y: 0px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: (root.selected_all_app < root.all_apps_list.length && root.all_apps_list[root.selected_all_app].in_dock) ?
                                "−   Remove from Home Dock" :
                                "★   Add to Home Dock";
                            font-size: 13px;
                            font-weight: (root.selected_all_app_action == 1) ? 700 : 500;
                            color: #ffffff;
                        }

                        Text {
                            x: parent.width - 28px;
                            y: 0px;
                            width: 16px;
                            height: parent.height;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            text: "›";
                            font-size: 18px;
                            font-weight: 600;
                            color: (root.selected_all_app_action == 1) ? #ffffff : rgba(255, 255, 255, 0.35);
                        }
                    }

                    // Modal Dismiss Hint
                    Text {
                        x: 20px;
                        y: 192px;
                        width: parent.width - 40px;
                        horizontal-alignment: center;
                        text: "OK Select  ·  Back Cancel";
                        font-size: 11px;
                        font-weight: 500;
                        color: rgba(255, 255, 255, 0.55);
                    }
                }
            }
        }
    }

    // Remote D-pad event capture
    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.key_up(); accept; }
            else if (event.text == Key.DownArrow) { root.key_down(); accept; }
            else if (event.text == Key.LeftArrow) { root.key_left(); accept; }
            else if (event.text == Key.RightArrow) { root.key_right(); accept; }
            else if (event.text == Key.Return) { root.key_ok(); accept; }
            else if (event.text == Key.Escape || event.text == Key.Back) { root.key_back(); accept; }
            else { reject; }
        }
    }
}
