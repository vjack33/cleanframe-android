import "./assets/fonts/Geist-Variable.ttf";
import "./assets/fonts/Newsreader-Variable.ttf";

export struct AppItem {
    id: string,
    name: string,
    pkg: string,
    icon: image,
}

export struct HdmiItem {
    id: string,
    label: string,
    connected: bool,
}

export struct SettingItem {
    id: string,
    label: string,
    value: string,
}

export struct DetailOption {
    id: string,
    title: string,
    desc: string,
    active: bool,
}

export component MainWindow inherits Window {
    width: 960px;
    height: 540px;
    default-font-family: (root.current_font == "Newsreader") ? "Newsreader" :
                         (root.current_font == "Geist") ? "Geist" : "sans-serif";

    // Appearance State Properties
    in property <string> clock_text: "1:54";
    in property <string> focused_caption: "Prime Video";
    in property <int> wallpaper_idx: 3; // 0..14 (All 15 Curated Photographic Wallpapers)
    in property <string> current_layout: "List"; // "List" | "Dock"
    in property <string> current_font: "Manrope"; // "Manrope" | "Newsreader" | "Geist"
    in property <string> current_material: "Frost"; // "Frost" | "Soft" | "Clear tint"
    in property <string> current_focus_style: "Glass, Soft"; // "Glass, Soft" | "Minimal Pill"
    in property <string> current_icon_pack: "CleanFrame default"; // "CleanFrame default" | "Full Color"

    // Primary Home Apps (8 Apps)
    in property <[AppItem]> apps: [
        { id: "youtube", name: "SmartTube", pkg: "org.smarttube.stable", icon: @image-url("assets/icons/youtube.svg") },
        { id: "spotify", name: "Spotify", pkg: "com.spotify.tv.android", icon: @image-url("assets/icons/spotify.svg") },
        { id: "appletv", name: "Apple TV", pkg: "com.apple.atve.androidtv.appletv", icon: @image-url("assets/icons/appletv.svg") },
        { id: "primevideo", name: "Prime Video", pkg: "com.amazon.amazonvideo.livingroom", icon: @image-url("assets/icons/primevideo.svg") },
        { id: "netflix", name: "Netflix", pkg: "com.netflix.ninja", icon: @image-url("assets/icons/netflix.svg") },
        { id: "aurora", name: "Aurora Store", pkg: "com.aurora.store", icon: @image-url("assets/icons/aurora.svg") },
        { id: "projectivy", name: "Projectivy Launcher", pkg: "com.spocky.projengmenu", icon: @image-url("assets/icons/projectivy.svg") },
        { id: "settings", name: "Settings", pkg: "android.settings.SETTINGS", icon: @image-url("assets/icons/settings.svg") }
    ];
    in property <int> selected_app: 3;

    // HDMI Inputs Shelf
    in property <[HdmiItem]> inputs: [
        { id: "hw1", label: "HDMI 1 · Mac", connected: true },
        { id: "hw2", label: "HDMI 2", connected: false },
        { id: "hw3", label: "HDMI 3", connected: true },
        { id: "av", label: "AV", connected: false }
    ];
    in property <int> selected_input: 0;

    // Utilities Shelf: 4 Controls
    in property <[string]> utils: ["Art Mode", "All apps", "Inputs", "Settings"];
    in property <int> selected_util: 0;

    // Active Navigation Zone: "apps" | "inputs" | "util" | "media"
    in property <string> active_zone: "apps";

    // Now Playing State (Default false, matches webview on TV when no media active)
    in property <bool> now_playing_visible: false;
    in property <string> now_playing_title: "CleanFrame Ambient";
    in property <string> now_playing_artist: "The Frame Audio";
    in property <bool> now_playing_playing: false;

    // Art Mode State
    in property <bool> art_mode: false;
    in property <string> art_title: "Mountain valley";
    in property <string> art_artist: "Aniket Deole · Unsplash";
    in property <bool> art_saved_notice: false;

    // Settings Navigation State
    in property <bool> settings_open: false;
    in property <bool> settings_detail: false;
    in property <string> detail_title: "Background";
    in property <string> detail_desc: "Choose a photographic background or solid color.";
    in property <int> selected_setting: 0;
    in property <int> selected_detail_option: 0;

    // 8 Settings Overview Items (Matching Webview Version Exactly)
    in property <[SettingItem]> settings_list: [
        { id: "background", label: "Background", value: "Mountain valley" },
        { id: "layout", label: "Layout", value: "List" },
        { id: "typography", label: "Typography", value: "Manrope" },
        { id: "icons", label: "Icon pack", value: "CleanFrame default" },
        { id: "focus", label: "Focus", value: "Glass, Soft" },
        { id: "inputs", label: "TV inputs", value: "Device dependent" },
        { id: "editor", label: "Apps on Home", value: "8 apps" },
        { id: "samsung", label: "Samsung", value: "Home and TV settings" }
    ];

    in property <[DetailOption]> detail_options: [];

    // Callbacks to Rust Controller
    callback key_up();
    callback key_down();
    callback key_left();
    callback key_right();
    callback key_ok();
    callback key_back();

    // 1. DYNAMIC PHOTOGRAPHIC WALLPAPER (All 15 Curated Artworks)
    Image {
        width: 100%;
        height: 100%;
        source: (root.wallpaper_idx == 0) ? @image-url("assets/wallpapers/misty.jpg") :
                (root.wallpaper_idx == 1) ? @image-url("assets/wallpapers/cove.jpg") :
                (root.wallpaper_idx == 2) ? @image-url("assets/wallpapers/forest.jpg") :
                (root.wallpaper_idx == 3) ? @image-url("assets/wallpapers/valley.jpg") :
                (root.wallpaper_idx == 4) ? @image-url("assets/wallpapers/night.jpg") :
                (root.wallpaper_idx == 5) ? @image-url("assets/wallpapers/peaks.jpg") :
                (root.wallpaper_idx == 6) ? @image-url("assets/wallpapers/bridge.jpg") :
                (root.wallpaper_idx == 7) ? @image-url("assets/wallpapers/ridge.jpg") :
                (root.wallpaper_idx == 8) ? @image-url("assets/wallpapers/golden.jpg") :
                (root.wallpaper_idx == 9) ? @image-url("assets/wallpapers/summit.jpg") :
                (root.wallpaper_idx == 10) ? @image-url("assets/wallpapers/goldcoast.jpg") :
                (root.wallpaper_idx == 11) ? @image-url("assets/wallpapers/sydney.jpg") :
                (root.wallpaper_idx == 12) ? @image-url("assets/wallpapers/amber.jpg") :
                (root.wallpaper_idx == 13) ? @image-url("assets/wallpapers/mint.jpg") :
                @image-url("assets/wallpapers/alpine.jpg");
        image-fit: cover;
    }

    // Material Scrim Overlay (matches .scrim + .shade from CSS)
    // CSS: .shade { top:0 height:300px; gradient to bottom rgba(4,10,12,.32) → transparent }
    // CSS: .scrim { top:560px height:520px; gradient to bottom transparent → rgba(4,10,12,.32) }
    if !root.art_mode: Rectangle {
        width: 100%;
        height: 100%;
        background: (root.current_material == "Clear tint") ?
            @linear-gradient(180deg, rgba(4, 10, 12, 0.38) 0%, rgba(4, 10, 12, 0.12) 28%, rgba(4, 10, 12, 0.06) 45%, rgba(4, 10, 12, 0.14) 72%, rgba(4, 10, 12, 0.32) 100%) :
            (root.current_material == "Soft") ?
            @linear-gradient(180deg, rgba(4, 10, 12, 0.28) 0%, rgba(4, 10, 12, 0.06) 28%, rgba(4, 10, 12, 0.02) 45%, rgba(4, 10, 12, 0.10) 72%, rgba(4, 10, 12, 0.28) 100%) :
            @linear-gradient(180deg, rgba(4, 10, 12, 0.32) 0%, rgba(4, 10, 12, 0.08) 28%, rgba(4, 10, 12, 0.04) 45%, rgba(4, 10, 12, 0.12) 72%, rgba(4, 10, 12, 0.32) 100%);
    }

    // 2. CLOCK & FOCUSED ITEM CAPTION
    // In DOCK layout: positioned at Top-Left (matching real_tv_webview_restored.png)
    // In LIST layout: positioned at Top-Right (matching list layout design)
    if (!root.settings_open && !root.art_mode): Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 36px;
            text: root.clock_text;
            font-size: 46px;
            font-weight: 500;
            color: #f6f1e7;
        }

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 92px;
            text: root.focused_caption;
            font-size: 19px;
            font-weight: 500;
            color: rgba(246, 241, 231, 0.90);
        }
    }

    // 3. HOME ELEMENTS (Hidden in Art Mode & Settings)
    if (!root.settings_open && !root.art_mode): Rectangle {
        width: 100%;
        height: 100%;

        // ==========================================
        // --- LIST LAYOUT (Photographic Typography) ---
        // ==========================================
        if root.current_layout == "List": Rectangle {
            x: 56px;
            y: 74px;
            width: 420px;
            height: 440px;

            for app[i] in root.apps: Rectangle {
                y: i * 52px;
                width: 320px;
                height: 48px;

                // Focus pill (Liquid Frosted Glass Capsule with Specular Highlight)
                // CSS ref: .f-glass .ph-plate { background: rgba(18,22,26,.55); border: 1px solid rgba(255,255,255,.16);
                //          box-shadow: 0 12px 32px rgba(0,0,0,.30), inset 0 1px 0 rgba(255,255,255,.24) }
                if (root.active_zone == "apps" && root.selected_app == i): Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 260px;
                    height: 48px;

                    // Drop shadow
                    Rectangle {
                        x: 2px;
                        y: 4px;
                        width: parent.width - 4px;
                        height: parent.height - 2px;
                        border-radius: 24px;
                        background: rgba(0, 0, 0, 0.32);
                    }

                    // Liquid frosted glass capsule body
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 24px;
                        background: (root.current_focus_style == "Minimal Pill") ?
                            rgba(255, 255, 255, 0.20) :
                            @linear-gradient(165deg, rgba(246, 241, 231, 0.46) 0%, rgba(246, 241, 231, 0.22) 48%, rgba(246, 241, 231, 0.32) 100%);
                        border-width: 1.2px;
                        border-color: rgba(255, 255, 255, 0.38);

                        // Inset top specular highlight
                        if (root.current_focus_style == "Glass, Soft"): Rectangle {
                            x: 16px;
                            y: 1px;
                            width: parent.width - 32px;
                            height: 1.2px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.60) 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }
                }

                // App Brand Icon
                Image {
                    x: 14px;
                    y: 11px;
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                    source: app.icon;
                    colorize: (root.current_icon_pack == "Full Color") ?
                        #ffffff :
                        ((root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.85));
                }

                // App Name
                Text {
                    x: 52px;
                    y: 9px;
                    text: app.name;
                    font-size: (root.active_zone == "apps" && root.selected_app == i) ? 26px : 24px;
                    font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 700 : 500;
                    color: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.78);
                }
            }
        }

        // ==========================================
        // --- DOCK LAYOUT (Apple Liquid Glass) ---
        // ==========================================
        if root.current_layout == "Dock": Rectangle {
            x: (root.width - 752px) / 2;
            y: 338px;
            width: 752px;
            height: 116px;

            // 1. Ambient Volumetric Shadow (Soft blurred ground shadow)
            Rectangle {
                x: 8px;
                y: 14px;
                width: parent.width - 16px;
                height: parent.height;
                border-radius: 28px;
                background: rgba(0, 0, 0, 0.38);
            }
            // Direct Contact Shadow
            Rectangle {
                x: 3px;
                y: 6px;
                width: parent.width - 6px;
                height: parent.height;
                border-radius: 26px;
                background: rgba(0, 0, 0, 0.24);
            }

            // 2. Liquid Glass Backdrop Mat (Apple macOS / visionOS Crystalline Frosted Material)
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 26px;
                background: (root.current_material == "Clear tint") ?
                    @linear-gradient(180deg, rgba(255, 255, 255, 0.26) 0%, rgba(20, 26, 32, 0.68) 20%, rgba(10, 14, 18, 0.84) 100%) :
                    (root.current_material == "Soft") ?
                    @linear-gradient(180deg, rgba(255, 255, 255, 0.30) 0%, rgba(24, 30, 38, 0.52) 20%, rgba(14, 18, 24, 0.70) 100%) :
                    @linear-gradient(180deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0.12) 8%, rgba(20, 26, 34, 0.56) 24%, rgba(12, 16, 22, 0.75) 100%);
                border-width: 1.2px;
                border-color: rgba(255, 255, 255, 0.32);

                // Diagonal Liquid Light Sheen (Apple visionOS signature specular reflection)
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: 26px;
                    background: @linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.0) 40%, rgba(255, 255, 255, 0.03) 75%, rgba(255, 255, 255, 0.10) 100%);
                }

                // Top Specular Inset Rim Highlight (Simulates laser-cut glass refraction)
                Rectangle {
                    x: 18px;
                    y: 1px;
                    width: parent.width - 36px;
                    height: 1.5px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.60) 20%, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0.60) 80%, rgba(255, 255, 255, 0.0) 100%);
                }

                // Bottom subtle bevel line
                Rectangle {
                    x: 24px;
                    y: parent.height - 2px;
                    width: parent.width - 48px;
                    height: 1px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.14) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            // 3. Sliding Carousel Track
            Rectangle {
                x: 8px;
                y: 8px;
                width: 736px;
                height: 100px;
                clip: true;

                Rectangle {
                    x: -clamp((root.selected_app - 2) * 144px, 0px, 432px);
                    y: 0px;
                    width: 1152px;
                    height: 100px;

                    animate x { duration: 160ms; }

                    for app[i] in root.apps: Rectangle {
                        x: i * 144px;
                        y: 0px;
                        width: 144px;
                        height: 100px;
                        border-radius: 18px;

                        // Apple visionOS / tvOS Liquid Glass Focus Plate
                        if (root.active_zone == "apps" && root.selected_app == i): Rectangle {
                            // Elevated Drop Shadow
                            Rectangle {
                                x: 2px;
                                y: 6px;
                                width: parent.width - 4px;
                                height: parent.height + 2px;
                                border-radius: 18px;
                                background: rgba(0, 0, 0, 0.42);
                            }

                            // Liquid Glass Lens Body
                            y: -2px;
                            width: 100%;
                            height: parent.height + 4px;
                            border-radius: 18px;
                            background: (root.current_focus_style == "Minimal Pill") ?
                                rgba(255, 255, 255, 0.32) :
                                @linear-gradient(165deg, rgba(255, 255, 255, 0.72) 0%, rgba(240, 235, 225, 0.42) 46%, rgba(248, 244, 236, 0.58) 100%);
                            border-width: 1.5px;
                            border-color: rgba(255, 255, 255, 0.75);

                            // Inset Top Specular Refraction Gleam
                            if (root.current_focus_style == "Glass, Soft"): Rectangle {
                                x: 12px;
                                y: 1px;
                                width: parent.width - 24px;
                                height: 1.5px;
                                background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.95) 50%, rgba(255, 255, 255, 0.0) 100%);
                            }
                        }

                        // App Brand Icon
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (root.active_zone == "apps" && root.selected_app == i) ? 17px : 20px;
                            width: (root.active_zone == "apps" && root.selected_app == i) ? 36px : 32px;
                            height: (root.active_zone == "apps" && root.selected_app == i) ? 36px : 32px;
                            image-fit: contain;
                            source: app.icon;
                            colorize: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(255, 255, 255, 0.88);
                        }

                        // App Label
                        Text {
                            x: 4px;
                            y: 62px;
                            width: parent.width - 8px;
                            horizontal-alignment: center;
                            text: app.name;
                            font-size: (root.active_zone == "apps" && root.selected_app == i) ? 13px : 12px;
                            font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 600 : 500;
                            color: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.82);
                            overflow: elide;
                        }
                    }
                }

                // Left Edge Fade Mask (.shelf.fade-l from CSS)
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 24px;
                    height: 100%;
                    background: @linear-gradient(90deg, rgba(14, 18, 24, 0.55) 0%, rgba(14, 18, 24, 0.0) 100%);
                }

                // Right Edge Fade Mask (.shelf.fade-r from CSS)
                Rectangle {
                    x: parent.width - 24px;
                    y: 0px;
                    width: 24px;
                    height: 100%;
                    background: @linear-gradient(270deg, rgba(14, 18, 24, 0.55) 0%, rgba(14, 18, 24, 0.0) 100%);
                }
            }
        }

        // ==========================================
        // --- HDMI INPUTS SHELF (Apple Glass Segmented Pills) ---
        // ==========================================
        Rectangle {
            x: (root.current_layout == "List") ? 540px : (root.width - 364px) / 2;
            y: (root.current_layout == "List") ? 332px : 298px;
            width: 364px;
            height: 28px;

            for hdmi[h_idx] in root.inputs: Rectangle {
                x: (h_idx == 0) ? 0px :
                   (h_idx == 1) ? 116px :
                   (h_idx == 2) ? 200px : 284px;
                y: 0px;
                width: (h_idx == 0) ? 108px :
                       (h_idx == 1) ? 76px :
                       (h_idx == 2) ? 76px : 68px;
                height: 26px;
                border-radius: 12px;

                // Pill Ambient Shadow
                Rectangle {
                    x: 1px;
                    y: 2px;
                    width: parent.width - 2px;
                    height: parent.height;
                    border-radius: 12px;
                    background: rgba(0, 0, 0, 0.28);
                }

                // Apple Liquid Glass Pill Body
                background: (root.active_zone == "inputs" && root.selected_input == h_idx) ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.70) 0%, rgba(240, 235, 225, 0.40) 50%, rgba(248, 244, 236, 0.55) 100%) :
                    @linear-gradient(180deg, rgba(255, 255, 255, 0.20) 0%, rgba(18, 22, 28, 0.60) 100%);
                border-width: (root.active_zone == "inputs" && root.selected_input == h_idx) ? 1.5px : 1px;
                border-color: (root.active_zone == "inputs" && root.selected_input == h_idx) ?
                    rgba(255, 255, 255, 0.80) :
                    rgba(255, 255, 255, 0.22);

                animate background { duration: 110ms; }

                // Top specular inset for focused HDMI pill
                if (root.active_zone == "inputs" && root.selected_input == h_idx): Rectangle {
                    x: 8px;
                    y: 1px;
                    width: parent.width - 16px;
                    height: 1.2px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.95) 50%, rgba(255, 255, 255, 0.0) 100%);
                }

                // LiveTV Icon
                Image {
                    x: 7px;
                    y: 6px;
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                    source: @image-url("assets/icons/livetv.svg");
                    colorize: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : rgba(255, 255, 255, 0.85);
                }

                // HDMI Label
                Text {
                    x: 24px;
                    y: 5px;
                    text: hdmi.label;
                    font-size: 11px;
                    font-weight: (root.active_zone == "inputs" && root.selected_input == h_idx) ? 600 : 500;
                    color: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : #f6f1e7;
                }

                // Status Dot (Apple Emerald Jewel Glow)
                Rectangle {
                    x: parent.width - 11px;
                    y: 10px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: hdmi.connected ? #30d158 : rgba(255, 255, 255, 0.28);
                }
            }
        }

        // ==========================================
        // --- UTILITIES CONTROLS (Apple Liquid Glass) ---
        // ==========================================
        // List mode: Right-aligned vertical column
        if root.current_layout == "List": Rectangle {
            x: root.width - 180px - 56px;
            y: 376px;
            width: 180px;
            height: 140px;

            for u[u_idx] in root.utils: Rectangle {
                y: u_idx * 32px;
                width: 180px;
                height: 28px;
                border-radius: 14px;
                background: (root.active_zone == "util" && root.selected_util == u_idx) ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.45) 0%, rgba(240, 235, 225, 0.22) 50%, rgba(248, 244, 236, 0.32) 100%) :
                    rgba(255, 255, 255, 0.0);
                border-width: (root.active_zone == "util" && root.selected_util == u_idx) ? 1.2px : 0px;
                border-color: rgba(255, 255, 255, 0.65);

                animate background { duration: 110ms; }

                Text {
                    x: 0px;
                    y: 5px;
                    width: 148px;
                    horizontal-alignment: right;
                    text: u;
                    font-size: 14px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 400;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.70);
                }

                Image {
                    x: 156px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/livetv.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(255, 255, 255, 0.70);
                }
            }
        }

        // Dock mode: Top-Right horizontal utilities (Apple Liquid Glass Island)
        if root.current_layout == "Dock": Rectangle {
            x: root.width - 430px;
            y: 34px;
            width: 374px;
            height: 34px;

            // Ambient Glass Island Underlay
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 17px;
                background: @linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(16, 20, 26, 0.45) 100%);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.20);

                // Island top specular rim
                Rectangle {
                    x: 14px;
                    y: 1px;
                    width: parent.width - 28px;
                    height: 1px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.50) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            for u[u_idx] in root.utils: Rectangle {
                x: (u_idx == 0) ? 4px :
                   (u_idx == 1) ? 102px :
                   (u_idx == 2) ? 192px : 274px;
                y: 3px;
                width: (u_idx == 0) ? 94px :
                       (u_idx == 1) ? 86px :
                       (u_idx == 2) ? 78px : 92px;
                height: 28px;
                border-radius: 14px;

                // Focused Button Apple Liquid Glass Capsule
                background: (root.active_zone == "util" && root.selected_util == u_idx) ?
                    @linear-gradient(165deg, rgba(255, 255, 255, 0.50) 0%, rgba(240, 235, 225, 0.26) 50%, rgba(248, 244, 236, 0.38) 100%) :
                    rgba(255, 255, 255, 0.0);
                border-width: (root.active_zone == "util" && root.selected_util == u_idx) ? 1.2px : 0px;
                border-color: rgba(255, 255, 255, 0.65);

                animate background { duration: 110ms; }

                Image {
                    x: 8px;
                    y: 6px;
                    width: 16px;
                    height: 16px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/livetv.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(255, 255, 255, 0.78);
                }

                Text {
                    x: 28px;
                    y: 6px;
                    text: u;
                    font-size: 12px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 500;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.78);
                }
            }
        }

        // ==========================================
        // --- NOW PLAYING MUSIC BAR ---
        // ==========================================
        if (root.now_playing_visible): Rectangle {
            x: (root.current_layout == "List") ? 540px : (root.width - 230px) / 2;
            y: (root.current_layout == "List") ? 284px : 252px;
            width: 230px;
            height: 36px;
            border-radius: 18px;
            // CSS ref: .now-playing.is-compact { background: rgba(18,22,25,.75); border: 1px solid rgba(255,255,255,.18);
            //          box-shadow: 0 14px 40px rgba(0,0,0,.30), inset 0 1px 0 rgba(255,255,255,.22) }
            background: (root.active_zone == "media") ?
                @linear-gradient(170deg, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.16) 58%, rgba(255, 255, 255, 0.22) 100%) :
                @linear-gradient(180deg, rgba(18, 22, 25, 0.75) 0%, rgba(12, 16, 20, 0.80) 100%);
            border-width: 1px;
            border-color: (root.active_zone == "media") ? rgba(255, 255, 255, 0.34) : rgba(255, 255, 255, 0.18);

            // Inset top specular highlight
            Rectangle {
                x: 12px;
                y: 1px;
                width: parent.width - 24px;
                height: 1px;
                background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.22) 50%, rgba(255, 255, 255, 0.0) 100%);
            }

            // Music note icon
            Image {
                x: 10px;
                y: 10px;
                width: 16px;
                height: 16px;
                image-fit: contain;
                source: @image-url("assets/icons/applemusic.svg");
                colorize: #ffffff;
            }

            // Track & Artist text
            Text {
                x: 32px;
                y: 5px;
                width: 160px;
                text: root.now_playing_title;
                font-size: 11px;
                font-weight: 600;
                color: #ffffff;
                overflow: elide;
            }

            Text {
                x: 32px;
                y: 19px;
                width: 160px;
                text: root.now_playing_artist;
                font-size: 9px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.70);
                overflow: elide;
            }

            // Play / Pause glyph
            Text {
                x: parent.width - 20px;
                y: 11px;
                text: root.now_playing_playing ? "❚❚" : "▶";
                font-size: 11px;
                color: #ffffff;
            }
        }
    }

    // ==========================================
    // 4. ART MODE OVERLAY (Ambient Gallery View)
    // ==========================================
    if root.art_mode: Rectangle {
        width: 100%;
        height: 100%;

        // Ambient Floating Plaque (Apple visionOS Spatial Glass Plaque)
        Rectangle {
            x: 56px;
            y: root.height - 130px;
            width: 440px;
            height: 80px;

            // Plaque volumetric drop shadow
            Rectangle {
                x: 3px;
                y: 8px;
                width: parent.width - 6px;
                height: parent.height;
                border-radius: 22px;
                background: rgba(0, 0, 0, 0.45);
            }

            // Liquid Glass Body
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: 22px;
                background: @linear-gradient(165deg, rgba(255, 255, 255, 0.28) 0%, rgba(20, 26, 34, 0.65) 25%, rgba(10, 14, 20, 0.82) 100%);
                border-width: 1.2px;
                border-color: rgba(255, 255, 255, 0.32);

                // Top specular refraction line
                Rectangle {
                    x: 18px;
                    y: 1px;
                    width: parent.width - 36px;
                    height: 1.5px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            Text {
                x: 22px;
                y: 13px;
                text: root.art_title;
                font-size: 20px;
                font-weight: 600;
                color: #ffffff;
            }

            Text {
                x: 22px;
                y: 37px;
                text: root.art_artist;
                font-size: 12px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.78);
            }

            Text {
                x: 22px;
                y: 57px;
                text: "‹ › Browse  ·  OK Set as wallpaper  ·  Back Exit";
                font-size: 11px;
                font-weight: 500;
                color: rgba(246, 241, 231, 0.55);
            }

            // Confirmation chip when wallpaper is set (Apple Emerald Pill)
            if root.art_saved_notice: Rectangle {
                x: parent.width - 130px;
                y: 14px;
                width: 116px;
                height: 24px;
                border-radius: 12px;
                background: #30d158;

                Text {
                    x: 0px;
                    y: 4px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "✓ Wallpaper Set";
                    font-size: 11px;
                    font-weight: 600;
                    color: #ffffff;
                }
            }
        }
    }

    // ==========================================
    // 5. MODAL SETTINGS SHEET
    // ==========================================
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        // CSS ref: .sheet-veil { background: rgba(8,12,14,.42) }  — but we layer a wallpaper behind it
        // Settings use a matte layer over the full wallpaper, darker for readability
        background: rgba(8, 12, 14, 0.58);

        // LEVEL 0: SETTINGS OVERVIEW LIST (Exact Match to real_tv_settings_opened.png)
        if !root.settings_detail: Rectangle {
            width: 100%;
            height: 100%;

            // Title
            Text {
                x: 56px;
                y: 36px;
                text: "Settings";
                font-size: 42px;
                font-weight: 500;
                color: #ffffff;
            }

            // Clock in Top-Right
            Text {
                x: root.width - self.width - 56px;
                y: 36px;
                text: root.clock_text;
                font-size: 46px;
                font-weight: 500;
                color: rgba(255, 255, 255, 0.65);
            }

            // 8 Settings Categories (CSS: .settings-group.is-focus { background: var(--solid) #f3f3ef })
            for s[s_idx] in root.settings_list: Rectangle {
                x: 56px;
                y: 86px + s_idx * 48px;
                width: 480px;
                height: 44px;
                border-radius: 16px;
                background: (root.selected_setting == s_idx) ?
                    #f3f3ef :
                    rgba(255, 255, 255, 0.0);

                animate background { duration: 110ms; }

                Rectangle {
                    x: 18px;
                    y: 4px;
                    width: 400px;
                    height: 36px;

                    Text {
                        x: 0px;
                        y: 0px;
                        text: s.label;
                        font-size: 16px;
                        font-weight: 600;
                        color: (root.selected_setting == s_idx) ? #111111 : #ffffff;
                    }

                    Text {
                        x: 0px;
                        y: 18px;
                        text: s.value;
                        font-size: 12px;
                        font-weight: 400;
                        color: (root.selected_setting == s_idx) ? #444444 : rgba(246, 241, 231, 0.68);
                    }
                }

                Text {
                    x: parent.width - 24px;
                    y: 11px;
                    text: "›";
                    font-size: 18px;
                    font-weight: 400;
                    color: (root.selected_setting == s_idx) ? #222222 : rgba(255, 255, 255, 0.45);
                }
            }

            // Bottom Prompt Bar
            Rectangle {
                x: 56px;
                y: 494px;
                height: 28px;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 32px;
                    height: 24px;
                    border-radius: 12px;
                    background: rgba(255, 255, 255, 0.22);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.4);

                    Text {
                        x: 0px;
                        y: 3px;
                        width: parent.width;
                        horizontal-alignment: center;
                        text: "OK";
                        font-size: 11px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                }

                Text {
                    x: 40px;
                    y: 4px;
                    text: "Open selected group";
                    font-size: 14px;
                    font-weight: 400;
                    color: rgba(246, 241, 231, 0.88);
                }
            }
        }

        // LEVEL 1: DETAILED SUBMENU OPTIONS
        if root.settings_detail: Rectangle {
            width: 100%;
            height: 100%;

            // Back Header: ‹ Settings
            Rectangle {
                x: 56px;
                y: 32px;
                width: 120px;
                height: 28px;
                border-radius: 14px;
                background: (root.selected_detail_option == -1) ? #f6f1e7 : rgba(255, 255, 255, 0.16);

                Text {
                    x: 12px;
                    y: 5px;
                    text: "‹ Settings";
                    font-size: 14px;
                    font-weight: 600;
                    color: (root.selected_detail_option == -1) ? #111111 : #ffffff;
                }
            }

            // Clock in Top-Right
            Text {
                x: root.width - self.width - 56px;
                y: 36px;
                text: root.clock_text;
                font-size: 46px;
                font-weight: 500;
                color: rgba(255, 255, 255, 0.65);
            }

            // Submenu Title
            Text {
                x: 56px;
                y: 68px;
                text: root.detail_title;
                font-size: 32px;
                font-weight: 600;
                color: #ffffff;
            }

            // Submenu Description
            Text {
                x: 56px;
                y: 104px;
                text: root.detail_desc;
                font-size: 13px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.70);
            }

            // Submenu Options List (Scrollable offset)
            Rectangle {
                x: 56px;
                y: 134px;
                width: 540px;
                height: 350px;
                clip: true;

                for opt[o_idx] in root.detail_options: Rectangle {
                    x: 0px;
                    y: (o_idx * 50px) - ((root.selected_detail_option > 5) ? (root.selected_detail_option - 5) * 50px : 0px);
                    width: 520px;
                    height: 46px;
                    border-radius: 14px;
                    background: (root.selected_detail_option == o_idx) ?
                        #f5f2eb :
                        rgba(255, 255, 255, 0.08);
                    border-width: (root.selected_detail_option == o_idx) ? 0px : 1px;
                    border-color: rgba(255, 255, 255, 0.14);

                    animate background { duration: 110ms; }
                    animate y { duration: 120ms; }

                    // Selection radio dot
                    Rectangle {
                        x: 16px;
                        y: 17px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        border-width: 1.5px;
                        border-color: (root.selected_detail_option == o_idx) ? #111111 : rgba(255, 255, 255, 0.5);
                        background: opt.active ? ((root.selected_detail_option == o_idx) ? #111111 : #30d158) : rgba(0, 0, 0, 0);
                    }

                    // Title & Description
                    Text {
                        x: 38px;
                        y: 6px;
                        text: opt.title;
                        font-size: 15px;
                        font-weight: 600;
                        color: (root.selected_detail_option == o_idx) ? #111111 : #ffffff;
                    }

                    Text {
                        x: 38px;
                        y: 24px;
                        text: opt.desc;
                        font-size: 11px;
                        font-weight: 400;
                        color: (root.selected_detail_option == o_idx) ? #444444 : rgba(246, 241, 231, 0.65);
                    }
                }
            }

            // Bottom Prompt
            Rectangle {
                x: 56px;
                y: 494px;
                height: 28px;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 32px;
                    height: 24px;
                    border-radius: 12px;
                    background: rgba(255, 255, 255, 0.22);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.4);

                    Text {
                        x: 0px;
                        y: 3px;
                        width: parent.width;
                        horizontal-alignment: center;
                        text: "OK";
                        font-size: 11px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                }

                Text {
                    x: 40px;
                    y: 4px;
                    text: "Select option  ·  Back to return";
                    font-size: 14px;
                    font-weight: 400;
                    color: rgba(246, 241, 231, 0.88);
                }
            }
        }
    }

    // Remote D-pad event capture
    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.key_up(); accept; }
            else if (event.text == Key.DownArrow) { root.key_down(); accept; }
            else if (event.text == Key.LeftArrow) { root.key_left(); accept; }
            else if (event.text == Key.RightArrow) { root.key_right(); accept; }
            else if (event.text == Key.Return) { root.key_ok(); accept; }
            else if (event.text == Key.Escape || event.text == Key.Back) { root.key_back(); accept; }
            else { reject; }
        }
    }
}
