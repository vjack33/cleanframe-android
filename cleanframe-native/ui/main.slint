import "./assets/fonts/Geist-Variable.ttf";
import "./assets/fonts/Newsreader-Variable.ttf";

export struct AppItem {
    id: string,
    name: string,
    pkg: string,
    icon: image,
}

export struct HdmiItem {
    id: string,
    label: string,
    connected: bool,
}

export struct SettingItem {
    id: string,
    label: string,
    value: string,
}

export struct DetailOption {
    id: string,
    title: string,
    desc: string,
    active: bool,
}

export component MainWindow inherits Window {
    width: 960px;
    height: 540px;
    default-font-family: (root.current_font == "Newsreader") ? "Newsreader" :
                         (root.current_font == "Geist") ? "Geist" : "sans-serif";

    // Appearance State Properties
    in property <string> clock_text: "1:54";
    in property <string> focused_caption: "Prime Video";
    in property <int> wallpaper_idx: 3; // 0..14 (All 15 Curated Photographic Wallpapers)
    in property <string> current_layout: "List"; // "List" | "Dock"
    in property <string> current_font: "Manrope"; // "Manrope" | "Newsreader" | "Geist"
    in property <string> current_material: "Frost"; // "Frost" | "Soft" | "Clear tint"
    in property <string> current_focus_style: "Glass, Soft"; // "Glass, Soft" | "Minimal Pill"
    in property <string> current_icon_pack: "CleanFrame default"; // "CleanFrame default" | "Full Color"

    // Primary Home Apps (8 Apps)
    in property <[AppItem]> apps: [
        { id: "youtube", name: "SmartTube", pkg: "org.smarttube.stable", icon: @image-url("assets/icons/youtube.svg") },
        { id: "spotify", name: "Spotify", pkg: "com.spotify.tv.android", icon: @image-url("assets/icons/spotify.svg") },
        { id: "appletv", name: "Apple TV", pkg: "com.apple.atve.androidtv.appletv", icon: @image-url("assets/icons/appletv.svg") },
        { id: "primevideo", name: "Prime Video", pkg: "com.amazon.amazonvideo.livingroom", icon: @image-url("assets/icons/primevideo.svg") },
        { id: "netflix", name: "Netflix", pkg: "com.netflix.ninja", icon: @image-url("assets/icons/netflix.svg") },
        { id: "aurora", name: "Aurora Store", pkg: "com.aurora.store", icon: @image-url("assets/icons/aurora.svg") },
        { id: "projectivy", name: "Projectivy Launcher", pkg: "com.spocky.projengmenu", icon: @image-url("assets/icons/projectivy.svg") },
        { id: "settings", name: "Settings", pkg: "android.settings.SETTINGS", icon: @image-url("assets/icons/settings.svg") }
    ];
    in property <int> selected_app: 3;

    // HDMI Inputs Shelf
    in property <[HdmiItem]> inputs: [
        { id: "hw1", label: "HDMI 1 · Mac", connected: true },
        { id: "hw2", label: "HDMI 2", connected: false },
        { id: "hw3", label: "HDMI 3", connected: true },
        { id: "av", label: "AV", connected: false }
    ];
    in property <int> selected_input: 0;

    // Utilities Shelf: 4 Controls
    in property <[string]> utils: ["Art Mode", "All apps", "Inputs", "Settings"];
    in property <int> selected_util: 0;

    // Active Navigation Zone: "apps" | "inputs" | "util" | "media"
    in property <string> active_zone: "apps";

    // Now Playing State (Default false, matches webview on TV when no media active)
    in property <bool> now_playing_visible: false;
    in property <string> now_playing_title: "CleanFrame Ambient";
    in property <string> now_playing_artist: "The Frame Audio";
    in property <bool> now_playing_playing: false;

    // Art Mode State
    in property <bool> art_mode: false;
    in property <string> art_title: "Mountain valley";
    in property <string> art_artist: "Aniket Deole · Unsplash";
    in property <bool> art_saved_notice: false;

    // Settings Navigation State
    in property <bool> settings_open: false;
    in property <bool> settings_detail: false;
    in property <string> detail_title: "Background";
    in property <string> detail_desc: "Choose a photographic background or solid color.";
    in property <int> selected_setting: 0;
    in property <int> selected_detail_option: 0;

    // 8 Settings Overview Items (Matching Webview Version Exactly)
    in property <[SettingItem]> settings_list: [
        { id: "background", label: "Background", value: "Mountain valley" },
        { id: "layout", label: "Layout", value: "List" },
        { id: "typography", label: "Typography", value: "Manrope" },
        { id: "icons", label: "Icon pack", value: "CleanFrame default" },
        { id: "focus", label: "Focus", value: "Glass, Soft" },
        { id: "inputs", label: "TV inputs", value: "Device dependent" },
        { id: "editor", label: "Apps on Home", value: "8 apps" },
        { id: "samsung", label: "Samsung", value: "Home and TV settings" }
    ];

    in property <[DetailOption]> detail_options: [];

    // Callbacks to Rust Controller
    callback key_up();
    callback key_down();
    callback key_left();
    callback key_right();
    callback key_ok();
    callback key_back();

    // 1. DYNAMIC PHOTOGRAPHIC WALLPAPER (All 15 Curated Artworks)
    Image {
        width: 100%;
        height: 100%;
        source: (root.wallpaper_idx == 0) ? @image-url("assets/wallpapers/misty.jpg") :
                (root.wallpaper_idx == 1) ? @image-url("assets/wallpapers/cove.jpg") :
                (root.wallpaper_idx == 2) ? @image-url("assets/wallpapers/forest.jpg") :
                (root.wallpaper_idx == 3) ? @image-url("assets/wallpapers/valley.jpg") :
                (root.wallpaper_idx == 4) ? @image-url("assets/wallpapers/night.jpg") :
                (root.wallpaper_idx == 5) ? @image-url("assets/wallpapers/peaks.jpg") :
                (root.wallpaper_idx == 6) ? @image-url("assets/wallpapers/bridge.jpg") :
                (root.wallpaper_idx == 7) ? @image-url("assets/wallpapers/ridge.jpg") :
                (root.wallpaper_idx == 8) ? @image-url("assets/wallpapers/golden.jpg") :
                (root.wallpaper_idx == 9) ? @image-url("assets/wallpapers/summit.jpg") :
                (root.wallpaper_idx == 10) ? @image-url("assets/wallpapers/goldcoast.jpg") :
                (root.wallpaper_idx == 11) ? @image-url("assets/wallpapers/sydney.jpg") :
                (root.wallpaper_idx == 12) ? @image-url("assets/wallpapers/amber.jpg") :
                (root.wallpaper_idx == 13) ? @image-url("assets/wallpapers/mint.jpg") :
                @image-url("assets/wallpapers/alpine.jpg");
        image-fit: cover;
    }

    // Material Scrim Overlay (matches .scrim + .shade from CSS)
    // CSS: .shade { top:0 height:300px; gradient to bottom rgba(4,10,12,.32) → transparent }
    // CSS: .scrim { top:560px height:520px; gradient to bottom transparent → rgba(4,10,12,.32) }
    if !root.art_mode: Rectangle {
        width: 100%;
        height: 100%;
        background: (root.current_material == "Clear tint") ?
            @linear-gradient(180deg, rgba(4, 10, 12, 0.38) 0%, rgba(4, 10, 12, 0.12) 28%, rgba(4, 10, 12, 0.06) 45%, rgba(4, 10, 12, 0.14) 72%, rgba(4, 10, 12, 0.32) 100%) :
            (root.current_material == "Soft") ?
            @linear-gradient(180deg, rgba(4, 10, 12, 0.28) 0%, rgba(4, 10, 12, 0.06) 28%, rgba(4, 10, 12, 0.02) 45%, rgba(4, 10, 12, 0.10) 72%, rgba(4, 10, 12, 0.28) 100%) :
            @linear-gradient(180deg, rgba(4, 10, 12, 0.32) 0%, rgba(4, 10, 12, 0.08) 28%, rgba(4, 10, 12, 0.04) 45%, rgba(4, 10, 12, 0.12) 72%, rgba(4, 10, 12, 0.32) 100%);
    }

    // 2. CLOCK & FOCUSED ITEM CAPTION
    // In DOCK layout: positioned at Top-Left (matching real_tv_webview_restored.png)
    // In LIST layout: positioned at Top-Right (matching list layout design)
    if (!root.settings_open && !root.art_mode): Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 36px;
            text: root.clock_text;
            font-size: 46px;
            font-weight: 500;
            color: #f6f1e7;
        }

        Text {
            x: (root.current_layout == "Dock") ? 56px : (root.width - self.width - 56px);
            y: 92px;
            text: root.focused_caption;
            font-size: 19px;
            font-weight: 500;
            color: rgba(246, 241, 231, 0.90);
        }
    }

    // 3. HOME ELEMENTS (Hidden in Art Mode & Settings)
    if (!root.settings_open && !root.art_mode): Rectangle {
        width: 100%;
        height: 100%;

        // ==========================================
        // --- LIST LAYOUT (Photographic Typography) ---
        // ==========================================
        if root.current_layout == "List": Rectangle {
            x: 56px;
            y: 74px;
            width: 420px;
            height: 440px;

            for app[i] in root.apps: Rectangle {
                y: i * 52px;
                width: 320px;
                height: 48px;

                // Non-focused subtle frosted glass plate
                if (root.active_zone != "apps" || root.selected_app != i): Rectangle {
                    x: 0px;
                    y: 2px;
                    width: 260px;
                    height: 44px;
                    border-radius: 22px;
                    background: rgba(255, 255, 255, 0.045);
                    border-width: 0.8px;
                    border-color: rgba(255, 255, 255, 0.10);
                }

                // Focus pill (Liquid Frosted Glass Capsule with Specular Highlight)
                if (root.active_zone == "apps" && root.selected_app == i): Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 260px;
                    height: 48px;

                    // Drop shadow
                    Rectangle {
                        x: 2px;
                        y: 4px;
                        width: parent.width - 4px;
                        height: parent.height - 2px;
                        border-radius: 24px;
                        background: rgba(0, 0, 0, 0.40);
                    }

                    // Liquid frosted glass capsule body
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 24px;
                        background: (root.current_focus_style == "Minimal Pill") ?
                            rgba(255, 255, 255, 0.28) :
                            @linear-gradient(155deg, rgba(255, 255, 255, 0.45) 0%, rgba(240, 245, 250, 0.22) 48%, rgba(255, 255, 255, 0.35) 100%);
                        border-width: 1.2px;
                        border-color: rgba(255, 255, 255, 0.75);

                        // Inset top specular highlight
                        if (root.current_focus_style == "Glass, Soft"): Rectangle {
                            x: 16px;
                            y: 1px;
                            width: parent.width - 32px;
                            height: 1.2px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, #ffffff 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }
                }

                // App Brand Icon
                Image {
                    x: 14px;
                    y: 11px;
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                    source: app.icon;
                    colorize: (root.current_icon_pack == "Full Color") ?
                        #ffffff :
                        ((root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.85));
                }

                // App Name
                Text {
                    x: 52px;
                    y: 9px;
                    text: app.name;
                    font-size: (root.active_zone == "apps" && root.selected_app == i) ? 26px : 24px;
                    font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 700 : 500;
                    color: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.78);
                }
            }
        }

        // ==========================================
        // --- DOCK LAYOUT (Liquid Frosted Glass) ---
        // ==========================================
        // Calibrated to liquid-rust Material::clear_bar (Apple iOS 26/27 Dock)
        // 960x540 geometry: width: 752px, height: 116px, y: 338px
        if root.current_layout == "Dock": Rectangle {
            x: (root.width - 752px) / 2;
            y: 338px;
            width: 752px;
            height: 116px;

            // 1. Volumetric Ambient Drop Shadows (liquid-rust offset_y: 8.0, blur: 15.0)
            Rectangle {
                x: 6px;
                y: 12px;
                width: parent.width - 12px;
                height: parent.height + 4px;
                border-radius: 28px;
                background: rgba(0, 0, 0, 0.45);
            }
            Rectangle {
                x: 2px;
                y: 6px;
                width: parent.width - 4px;
                height: parent.height;
                border-radius: 26px;
                background: rgba(0, 0, 0, 0.28);
            }

            // 2. Liquid Glass Backdrop Mat (liquid-rust Material::clear_bar: luminance 0.6, mix 0.33)
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 26px;
                background: (root.current_material == "Clear tint") ?
                    @linear-gradient(145deg, rgba(255, 255, 255, 0.18) 0%, rgba(153, 153, 153, 0.05) 26%, rgba(20, 26, 32, 0.58) 65%, rgba(10, 14, 18, 0.82) 100%) :
                    (root.current_material == "Soft") ?
                    @linear-gradient(145deg, rgba(255, 255, 255, 0.22) 0%, rgba(160, 160, 160, 0.08) 26%, rgba(24, 30, 38, 0.48) 65%, rgba(14, 18, 24, 0.70) 100%) :
                    @linear-gradient(145deg, rgba(255, 255, 255, 0.20) 0%, rgba(153, 153, 153, 0.07) 26%, rgba(18, 22, 28, 0.52) 65%, rgba(12, 16, 22, 0.75) 100%);
                border-width: 1.25px;
                border-color: rgba(255, 255, 255, 0.26);

                // Top Specular Inset Rim Highlight (liquid-rust 1.25pt inner hairline + #282828 dodge)
                Rectangle {
                    x: 24px;
                    y: 1px;
                    width: parent.width - 48px;
                    height: 1.25px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.42) 20%, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0.42) 80%, rgba(255, 255, 255, 0.0) 100%);
                }

                // Left specular edge highlight (directional light sweep)
                Rectangle {
                    x: 1px;
                    y: 20px;
                    width: 1px;
                    height: parent.height - 40px;
                    background: @linear-gradient(180deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.08) 100%);
                }

                // Bottom subtle edge burn (liquid-rust darkened hairline edge)
                Rectangle {
                    x: 32px;
                    y: parent.height - 2px;
                    width: parent.width - 64px;
                    height: 1px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            // 3. Sliding Carousel Track
            Rectangle {
                x: 8px;
                y: 8px;
                width: 736px;
                height: 100px;
                clip: true;

                Rectangle {
                    x: -clamp((root.selected_app - 2) * 144px, 0px, 432px);
                    y: 0px;
                    width: 1152px;
                    height: 100px;

                    animate x { duration: 160ms; }

                    for app[i] in root.apps: Rectangle {
                        x: i * 144px;
                        y: 0px;
                        width: 144px;
                        height: 100px;
                        border-radius: 16px;

                        // Non-focused subtle frosted glass plate (liquid-rust Material::regular dark tone)
                        if (root.active_zone != "apps" || root.selected_app != i): Rectangle {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            border-radius: 16px;
                            background: @linear-gradient(165deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.02) 40%, rgba(18, 22, 28, 0.35) 100%);
                            border-width: 0.8px;
                            border-color: rgba(255, 255, 255, 0.12);
                        }

                        // Focused Tile Liquid Glass Plate (liquid-rust Material::tinted stained crystal)
                        if (root.active_zone == "apps" && root.selected_app == i): Rectangle {
                            x: 6px;
                            y: 4px;
                            width: parent.width - 12px;
                            height: parent.height - 8px;

                            // Plate Outer Drop Shadow (liquid-rust offset_y: 6.0, blur: 14.0)
                            Rectangle {
                                x: 2px;
                                y: 6px;
                                width: parent.width - 4px;
                                height: parent.height;
                                border-radius: 18px;
                                background: rgba(0, 0, 0, 0.45);
                            }

                            // Plate Luminous Frosted Glass Body
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 18px;
                                background: (root.current_focus_style == "Minimal Pill") ?
                                    rgba(255, 255, 255, 0.28) :
                                    @linear-gradient(155deg, rgba(255, 255, 255, 0.48) 0%, rgba(235, 242, 250, 0.24) 48%, rgba(255, 255, 255, 0.36) 100%);
                                border-width: 1.25px;
                                border-color: rgba(255, 255, 255, 0.80);

                                // Inset top specular highlight
                                Rectangle {
                                    x: 12px;
                                    y: 1px;
                                    width: parent.width - 24px;
                                    height: 1.2px;
                                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, #ffffff 50%, rgba(255, 255, 255, 0.0) 100%);
                                }
                            }
                        }

                        // App Brand Icon
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (root.active_zone == "apps" && root.selected_app == i) ? 18px : 20px;
                            width: (root.active_zone == "apps" && root.selected_app == i) ? 34px : 30px;
                            height: (root.active_zone == "apps" && root.selected_app == i) ? 34px : 30px;
                            image-fit: contain;
                            source: app.icon;
                            colorize: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(255, 255, 255, 0.85);
                        }

                        // App Label
                        Text {
                            x: 4px;
                            y: 62px;
                            width: parent.width - 8px;
                            horizontal-alignment: center;
                            text: app.name;
                            font-size: (root.active_zone == "apps" && root.selected_app == i) ? 13px : 12px;
                            font-weight: (root.active_zone == "apps" && root.selected_app == i) ? 600 : 500;
                            color: (root.active_zone == "apps" && root.selected_app == i) ? #ffffff : rgba(246, 241, 231, 0.78);
                            overflow: elide;
                        }
                    }
                }

                // Left Edge Fade Mask
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 24px;
                    height: 100%;
                    background: @linear-gradient(90deg, rgba(14, 18, 24, 0.55) 0%, rgba(14, 18, 24, 0.0) 100%);
                }

                // Right Edge Fade Mask
                Rectangle {
                    x: parent.width - 24px;
                    y: 0px;
                    width: 24px;
                    height: 100%;
                    background: @linear-gradient(270deg, rgba(14, 18, 24, 0.55) 0%, rgba(14, 18, 24, 0.0) 100%);
                }
            }
        }

        // ==========================================
        // --- HDMI INPUTS CAPSULE TRAY ---
        // ==========================================
        Rectangle {
            x: (root.current_layout == "List") ? 530px : (root.width - 384px) / 2;
            y: (root.current_layout == "List") ? 330px : 294px;
            width: 384px;
            height: 32px;

            // Volumetric Drop Shadow
            Rectangle {
                x: 1px;
                y: 4px;
                width: parent.width - 2px;
                height: parent.height;
                border-radius: 16px;
                background: rgba(0, 0, 0, 0.32);
            }

            // Glass Capsule Tray Body (liquid-rust Material::clear_bar)
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 16px;
                background: @linear-gradient(165deg, rgba(255, 255, 255, 0.14) 0%, rgba(18, 24, 30, 0.52) 100%);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.24);

                // Inset top specular line
                Rectangle {
                    x: 14px;
                    y: 1px;
                    width: parent.width - 28px;
                    height: 1px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.45) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            // Segments inside the tray
            for hdmi[h_idx] in root.inputs: Rectangle {
                x: (h_idx == 0) ? 4px :
                   (h_idx == 1) ? 122px :
                   (h_idx == 2) ? 208px : 294px;
                y: 3px;
                width: (h_idx == 0) ? 114px :
                       (h_idx == 1) ? 82px :
                       (h_idx == 2) ? 82px : 82px;
                height: 26px;
                border-radius: 13px;

                // Focused Segment Luminous Liquid Glass Pill
                if (root.active_zone == "inputs" && root.selected_input == h_idx): Rectangle {
                    width: 100%;
                    height: 100%;

                    // Drop shadow
                    Rectangle {
                        x: 1px;
                        y: 2px;
                        width: parent.width - 2px;
                        height: parent.height;
                        border-radius: 13px;
                        background: rgba(0, 0, 0, 0.35);
                    }

                    // Body
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 13px;
                        background: @linear-gradient(165deg, rgba(255, 255, 255, 0.50) 0%, rgba(230, 235, 245, 0.26) 48%, rgba(255, 255, 255, 0.38) 100%);
                        border-width: 1.2px;
                        border-color: rgba(255, 255, 255, 0.75);

                        // Inset specular line
                        Rectangle {
                            x: 8px;
                            y: 1px;
                            width: parent.width - 16px;
                            height: 1px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, #ffffff 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }
                }

                // LiveTV Icon
                Image {
                    x: 8px;
                    y: 6px;
                    width: 14px;
                    height: 14px;
                    image-fit: contain;
                    source: @image-url("assets/icons/livetv.svg");
                    colorize: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : rgba(255, 255, 255, 0.75);
                }

                // HDMI Label
                Text {
                    x: 26px;
                    y: 5px;
                    text: hdmi.label;
                    font-size: 11px;
                    font-weight: (root.active_zone == "inputs" && root.selected_input == h_idx) ? 600 : 500;
                    color: (root.active_zone == "inputs" && root.selected_input == h_idx) ? #ffffff : #f6f1e7;
                }

                // Status Dot (Apple iOS 26 systemGreen #34C759 with radiant aura)
                if hdmi.connected: Rectangle {
                    x: parent.width - 14px;
                    y: 8px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: rgba(52, 199, 89, 0.28);
                }
                Rectangle {
                    x: parent.width - 12px;
                    y: 10px;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: hdmi.connected ? #34C759 : rgba(255, 255, 255, 0.28);
                }
            }
        }

        // ==========================================
        // --- UTILITIES CONTROLS ---
        // ==========================================
        // List mode: Right-aligned vertical column
        if root.current_layout == "List": Rectangle {
            x: root.width - 180px - 56px;
            y: 376px;
            width: 180px;
            height: 140px;

            for u[u_idx] in root.utils: Rectangle {
                y: u_idx * 32px;
                width: 180px;
                height: 28px;
                border-radius: 14px;

                if (root.active_zone == "util" && root.selected_util == u_idx): Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 14px;
                    background: @linear-gradient(165deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.16) 100%);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.50);
                }

                Text {
                    x: 0px;
                    y: 5px;
                    width: 148px;
                    horizontal-alignment: right;
                    text: u;
                    font-size: 15px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 400;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.65);
                }

                Image {
                    x: 156px;
                    y: 5px;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/quickpanel.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.65);
                }
            }
        }

        // Dock mode: Top-Right Floating Glass Island Capsule
        if root.current_layout == "Dock": Rectangle {
            x: root.width - 396px;
            y: 36px;
            width: 340px;
            height: 32px;

            // Volumetric Drop Shadow
            Rectangle {
                x: 1px;
                y: 4px;
                width: parent.width - 2px;
                height: parent.height;
                border-radius: 16px;
                background: rgba(0, 0, 0, 0.32);
            }

            // Glass Island Body
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 16px;
                background: @linear-gradient(165deg, rgba(255, 255, 255, 0.12) 0%, rgba(18, 22, 26, 0.50) 100%);
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.20);

                // Inset specular line
                Rectangle {
                    x: 14px;
                    y: 1px;
                    width: parent.width - 28px;
                    height: 1px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.40) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            for u[u_idx] in root.utils: Rectangle {
                x: (u_idx == 0) ? 4px :
                   (u_idx == 1) ? 94px :
                   (u_idx == 2) ? 174px : 252px;
                y: 3px;
                width: (u_idx == 0) ? 86px :
                       (u_idx == 1) ? 76px :
                       (u_idx == 2) ? 74px : 80px;
                height: 26px;
                border-radius: 13px;

                // Focused Luminous Liquid Glass Pill
                if (root.active_zone == "util" && root.selected_util == u_idx): Rectangle {
                    width: 100%;
                    height: 100%;

                    // Drop shadow
                    Rectangle {
                        x: 1px;
                        y: 2px;
                        width: parent.width - 2px;
                        height: parent.height;
                        border-radius: 13px;
                        background: rgba(0, 0, 0, 0.35);
                    }

                    // Body
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 13px;
                        background: @linear-gradient(165deg, rgba(255, 255, 255, 0.48) 0%, rgba(230, 235, 245, 0.24) 48%, rgba(255, 255, 255, 0.36) 100%);
                        border-width: 1.2px;
                        border-color: rgba(255, 255, 255, 0.75);

                        Rectangle {
                            x: 6px;
                            y: 1px;
                            width: parent.width - 12px;
                            height: 1px;
                            background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, #ffffff 50%, rgba(255, 255, 255, 0.0) 100%);
                        }
                    }
                }

                Image {
                    x: 8px;
                    y: 5px;
                    width: 16px;
                    height: 16px;
                    image-fit: contain;
                    source: (u_idx == 0) ? @image-url("assets/icons/art.svg") :
                            (u_idx == 1) ? @image-url("assets/icons/apps.svg") :
                            (u_idx == 2) ? @image-url("assets/icons/livetv.svg") :
                            @image-url("assets/icons/settings.svg");
                    colorize: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.75);
                }

                Text {
                    x: 28px;
                    y: 5px;
                    text: u;
                    font-size: 11px;
                    font-weight: (root.active_zone == "util" && root.selected_util == u_idx) ? 600 : 500;
                    color: (root.active_zone == "util" && root.selected_util == u_idx) ? #ffffff : rgba(246, 241, 231, 0.75);
                }
            }
        }

        // ==========================================
        // --- NOW PLAYING MUSIC BAR ---
        // ==========================================
        if (root.now_playing_visible): Rectangle {
            x: (root.current_layout == "List") ? 540px : (root.width - 230px) / 2;
            y: (root.current_layout == "List") ? 284px : 252px;
            width: 230px;
            height: 36px;
            border-radius: 18px;
            // CSS ref: .now-playing.is-compact { background: rgba(18,22,25,.75); border: 1px solid rgba(255,255,255,.18);
            //          box-shadow: 0 14px 40px rgba(0,0,0,.30), inset 0 1px 0 rgba(255,255,255,.22) }
            background: (root.active_zone == "media") ?
                @linear-gradient(170deg, rgba(255, 255, 255, 0.30) 0%, rgba(255, 255, 255, 0.16) 58%, rgba(255, 255, 255, 0.22) 100%) :
                @linear-gradient(180deg, rgba(18, 22, 25, 0.75) 0%, rgba(12, 16, 20, 0.80) 100%);
            border-width: 1px;
            border-color: (root.active_zone == "media") ? rgba(255, 255, 255, 0.34) : rgba(255, 255, 255, 0.18);

            // Inset top specular highlight
            Rectangle {
                x: 12px;
                y: 1px;
                width: parent.width - 24px;
                height: 1px;
                background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.22) 50%, rgba(255, 255, 255, 0.0) 100%);
            }

            // Music note icon
            Image {
                x: 10px;
                y: 10px;
                width: 16px;
                height: 16px;
                image-fit: contain;
                source: @image-url("assets/icons/applemusic.svg");
                colorize: #ffffff;
            }

            // Track & Artist text
            Text {
                x: 32px;
                y: 5px;
                width: 160px;
                text: root.now_playing_title;
                font-size: 11px;
                font-weight: 600;
                color: #ffffff;
                overflow: elide;
            }

            Text {
                x: 32px;
                y: 19px;
                width: 160px;
                text: root.now_playing_artist;
                font-size: 9px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.70);
                overflow: elide;
            }

            // Play / Pause glyph
            Text {
                x: parent.width - 20px;
                y: 11px;
                text: root.now_playing_playing ? "❚❚" : "▶";
                font-size: 11px;
                color: #ffffff;
            }
        }
    }

    // ==========================================
    // 4. ART MODE OVERLAY (Ambient Gallery View)
    // ==========================================
    if root.art_mode: Rectangle {
        width: 100%;
        height: 100%;

        // Ambient Floating Plaque (Liquid Frosted Glass)
        Rectangle {
            x: 56px;
            y: root.height - 130px;
            width: 440px;
            height: 80px;

            // Plaque multi-stage ambient shadow
            Rectangle {
                x: 4px;
                y: 10px;
                width: parent.width - 8px;
                height: parent.height + 2px;
                border-radius: 22px;
                background: rgba(0, 0, 0, 0.45);
            }
            Rectangle {
                x: 2px;
                y: 5px;
                width: parent.width - 4px;
                height: parent.height;
                border-radius: 20px;
                background: rgba(0, 0, 0, 0.30);
            }

            // Liquid glass body
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: 20px;
                background: @linear-gradient(145deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 35%, rgba(18, 22, 28, 0.58) 70%, rgba(10, 14, 18, 0.78) 100%);
                border-width: 1.2px;
                border-color: rgba(255, 255, 255, 0.28);

                // Top laser specular line
                Rectangle {
                    x: 16px;
                    y: 1px;
                    width: parent.width - 32px;
                    height: 1.2px;
                    background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0.0) 100%);
                }
            }

            Text {
                x: 20px;
                y: 12px;
                text: root.art_title;
                font-size: 20px;
                font-weight: 600;
                color: #ffffff;
            }

            Text {
                x: 20px;
                y: 36px;
                text: root.art_artist;
                font-size: 12px;
                font-weight: 400;
                color: rgba(246, 241, 231, 0.75);
            }

            Text {
                x: 20px;
                y: 56px;
                text: "‹ › Browse  ·  OK Set as wallpaper  ·  Back Exit";
                font-size: 10px;
                font-weight: 500;
                color: rgba(246, 241, 231, 0.50);
            }

            // Confirmation chip when wallpaper is set
            if root.art_saved_notice: Rectangle {
                x: parent.width - 130px;
                y: 14px;
                width: 116px;
                height: 24px;
                border-radius: 12px;
                background: #10b981;

                Text {
                    x: 0px;
                    y: 4px;
                    width: parent.width;
                    horizontal-alignment: center;
                    text: "✓ Wallpaper Set";
                    font-size: 11px;
                    font-weight: 600;
                    color: #ffffff;
                }
            }
        }
    }

    // ==========================================
    // 5. MODAL SETTINGS SHEET (Floating Liquid Glass)
    // ==========================================
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        // Darkened glass veil allowing ambient room/wallpaper to breathe through
        background: rgba(6, 10, 14, 0.65);

        // LEVEL 0: SETTINGS OVERVIEW LIST
        if !root.settings_detail: Rectangle {
            width: 100%;
            height: 100%;

            // Floating Hero Liquid Glass Card
            Rectangle {
                x: (root.width - 760px) / 2;
                y: (root.height - 480px) / 2;
                width: 760px;
                height: 480px;

                // Multi-tier volumetric drop shadows
                Rectangle {
                    x: 8px;
                    y: 18px;
                    width: parent.width - 16px;
                    height: parent.height + 4px;
                    border-radius: 26px;
                    background: rgba(0, 0, 0, 0.55);
                }
                Rectangle {
                    x: 3px;
                    y: 8px;
                    width: parent.width - 6px;
                    height: parent.height;
                    border-radius: 24px;
                    background: rgba(0, 0, 0, 0.35);
                }

                // Liquid glass body
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 24px;
                    background: @linear-gradient(145deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 35%, rgba(18, 22, 28, 0.62) 70%, rgba(10, 14, 18, 0.82) 100%);
                    border-width: 1.2px;
                    border-color: rgba(255, 255, 255, 0.28);

                    // Top specular highlight line
                    Rectangle {
                        x: 24px;
                        y: 1px;
                        width: parent.width - 48px;
                        height: 1.2px;
                        background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.60) 50%, rgba(255, 255, 255, 0.0) 100%);
                    }

                    // Left specular highlight line
                    Rectangle {
                        x: 1px;
                        y: 20px;
                        width: 1px;
                        height: parent.height - 40px;
                        background: @linear-gradient(180deg, rgba(255, 255, 255, 0.40) 0%, rgba(255, 255, 255, 0.10) 100%);
                    }
                }

                // Title
                Text {
                    x: 32px;
                    y: 22px;
                    text: "Settings";
                    font-size: 28px;
                    font-weight: 600;
                    color: #ffffff;
                }

                // Clock Chip in Top-Right
                Rectangle {
                    x: parent.width - 110px;
                    y: 22px;
                    width: 78px;
                    height: 28px;
                    border-radius: 14px;
                    background: rgba(255, 255, 255, 0.08);
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.15);

                    Text {
                        x: 0px;
                        y: 5px;
                        width: parent.width;
                        horizontal-alignment: center;
                        text: root.clock_text;
                        font-size: 14px;
                        font-weight: 500;
                        color: #ffffff;
                    }
                }

                // 8 Settings Categories List (Inside Panel)
                for s[s_idx] in root.settings_list: Rectangle {
                    x: 32px;
                    y: 64px + s_idx * 44px;
                    width: parent.width - 64px;
                    height: 40px;
                    border-radius: 12px;

                    // Non-focused subtle frosted glass plate
                    if (root.selected_setting != s_idx): Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 12px;
                        background: rgba(255, 255, 255, 0.045);
                        border-width: 0.8px;
                        border-color: rgba(255, 255, 255, 0.10);
                    }

                    // Focused elevated luminous plate
                    if (root.selected_setting == s_idx): Rectangle {
                        width: 100%;
                        height: 100%;

                        // Drop shadow
                        Rectangle {
                            x: 1px;
                            y: 3px;
                            width: parent.width - 2px;
                            height: parent.height;
                            border-radius: 12px;
                            background: rgba(0, 0, 0, 0.40);
                        }

                        // Luminous body
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 12px;
                            background: @linear-gradient(165deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 242, 248, 0.88) 100%);
                            border-width: 1.2px;
                            border-color: #ffffff;
                        }
                    }

                    // Label & Value
                    Text {
                        x: 16px;
                        y: 5px;
                        text: s.label;
                        font-size: 14px;
                        font-weight: 600;
                        color: (root.selected_setting == s_idx) ? #111111 : #ffffff;
                    }

                    Text {
                        x: 16px;
                        y: 21px;
                        text: s.value;
                        font-size: 11px;
                        font-weight: 400;
                        color: (root.selected_setting == s_idx) ? #444444 : rgba(246, 241, 231, 0.68);
                    }

                    Text {
                        x: parent.width - 24px;
                        y: 10px;
                        text: "›";
                        font-size: 16px;
                        font-weight: 600;
                        color: (root.selected_setting == s_idx) ? #111111 : rgba(255, 255, 255, 0.45);
                    }
                }

                // Bottom Prompt Bar
                Rectangle {
                    x: 32px;
                    y: parent.height - 42px;
                    height: 24px;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 32px;
                        height: 22px;
                        border-radius: 11px;
                        background: rgba(255, 255, 255, 0.20);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.35);

                        Text {
                            x: 0px;
                            y: 3px;
                            width: parent.width;
                            horizontal-alignment: center;
                            text: "OK";
                            font-size: 10px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                    }

                    Text {
                        x: 38px;
                        y: 4px;
                        text: "Open selected group  ·  Back Exit to Home";
                        font-size: 12px;
                        font-weight: 400;
                        color: rgba(246, 241, 231, 0.85);
                    }
                }
            }
        }

        // LEVEL 1: DETAILED SUBMENU OPTIONS
        if root.settings_detail: Rectangle {
            width: 100%;
            height: 100%;

            // Floating Hero Liquid Glass Card
            Rectangle {
                x: (root.width - 760px) / 2;
                y: (root.height - 480px) / 2;
                width: 760px;
                height: 480px;

                // Multi-tier volumetric drop shadows
                Rectangle {
                    x: 8px;
                    y: 18px;
                    width: parent.width - 16px;
                    height: parent.height + 4px;
                    border-radius: 26px;
                    background: rgba(0, 0, 0, 0.55);
                }
                Rectangle {
                    x: 3px;
                    y: 8px;
                    width: parent.width - 6px;
                    height: parent.height;
                    border-radius: 24px;
                    background: rgba(0, 0, 0, 0.35);
                }

                // Liquid glass body
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 24px;
                    background: @linear-gradient(145deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 35%, rgba(18, 22, 28, 0.62) 70%, rgba(10, 14, 18, 0.82) 100%);
                    border-width: 1.2px;
                    border-color: rgba(255, 255, 255, 0.28);

                    // Top specular highlight line
                    Rectangle {
                        x: 24px;
                        y: 1px;
                        width: parent.width - 48px;
                        height: 1.2px;
                        background: @linear-gradient(90deg, rgba(255, 255, 255, 0.0) 0%, rgba(255, 255, 255, 0.60) 50%, rgba(255, 255, 255, 0.0) 100%);
                    }

                    // Left specular highlight line
                    Rectangle {
                        x: 1px;
                        y: 20px;
                        width: 1px;
                        height: parent.height - 40px;
                        background: @linear-gradient(180deg, rgba(255, 255, 255, 0.40) 0%, rgba(255, 255, 255, 0.10) 100%);
                    }
                }

                // Back Button Glass Pill (‹ Settings)
                Rectangle {
                    x: 32px;
                    y: 20px;
                    width: 110px;
                    height: 28px;
                    border-radius: 14px;
                    background: (root.selected_detail_option == -1) ?
                        @linear-gradient(165deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 242, 248, 0.88) 100%) :
                        rgba(255, 255, 255, 0.10);
                    border-width: 1px;
                    border-color: (root.selected_detail_option == -1) ? #ffffff : rgba(255, 255, 255, 0.20);

                    Text {
                        x: 12px;
                        y: 5px;
                        text: "‹ Settings";
                        font-size: 13px;
                        font-weight: 600;
                        color: (root.selected_detail_option == -1) ? #111111 : #ffffff;
                    }
                }

                // Submenu Title
                Text {
                    x: 32px;
                    y: 56px;
                    text: root.detail_title;
                    font-size: 26px;
                    font-weight: 600;
                    color: #ffffff;
                }

                // Submenu Description
                Text {
                    x: 32px;
                    y: 88px;
                    text: root.detail_desc;
                    font-size: 12px;
                    font-weight: 400;
                    color: rgba(246, 241, 231, 0.70);
                }

                // Options List (Scrollable)
                Rectangle {
                    x: 32px;
                    y: 114px;
                    width: parent.width - 64px;
                    height: 310px;
                    clip: true;

                    for opt[o_idx] in root.detail_options: Rectangle {
                        x: 0px;
                        y: (o_idx * 48px) - ((root.selected_detail_option > 4) ? (root.selected_detail_option - 4) * 48px : 0px);
                        width: parent.width;
                        height: 44px;
                        border-radius: 12px;

                        // Non-focused subtle frosted glass plate
                        if (root.selected_detail_option != o_idx): Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 12px;
                            background: rgba(255, 255, 255, 0.045);
                            border-width: 0.8px;
                            border-color: rgba(255, 255, 255, 0.10);
                        }

                        // Focused elevated luminous plate
                        if (root.selected_detail_option == o_idx): Rectangle {
                            width: 100%;
                            height: 100%;

                            // Drop shadow
                            Rectangle {
                                x: 1px;
                                y: 3px;
                                width: parent.width - 2px;
                                height: parent.height;
                                border-radius: 12px;
                                background: rgba(0, 0, 0, 0.40);
                            }

                            // Body
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 12px;
                                background: @linear-gradient(165deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 242, 248, 0.88) 100%);
                                border-width: 1.2px;
                                border-color: #ffffff;
                            }
                        }

                        animate y { duration: 120ms; }

                        // Radio indicator dot (Apple iOS 26 systemGreen #34C759)
                        Rectangle {
                            x: 16px;
                            y: 16px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            border-width: 1.5px;
                            border-color: (root.selected_detail_option == o_idx) ? #111111 : rgba(255, 255, 255, 0.50);
                            background: opt.active ? ((root.selected_detail_option == o_idx) ? #111111 : #34C759) : rgba(0, 0, 0, 0);
                        }

                        // Option Title & Description
                        Text {
                            x: 38px;
                            y: 5px;
                            text: opt.title;
                            font-size: 14px;
                            font-weight: 600;
                            color: (root.selected_detail_option == o_idx) ? #111111 : #ffffff;
                        }

                        Text {
                            x: 38px;
                            y: 22px;
                            text: opt.desc;
                            font-size: 11px;
                            font-weight: 400;
                            color: (root.selected_detail_option == o_idx) ? #444444 : rgba(246, 241, 231, 0.65);
                        }
                    }
                }

                // Bottom Prompt
                Rectangle {
                    x: 32px;
                    y: parent.height - 42px;
                    height: 24px;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 32px;
                        height: 22px;
                        border-radius: 11px;
                        background: rgba(255, 255, 255, 0.20);
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.35);

                        Text {
                            x: 0px;
                            y: 3px;
                            width: parent.width;
                            horizontal-alignment: center;
                            text: "OK";
                            font-size: 10px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                    }

                    Text {
                        x: 38px;
                        y: 4px;
                        text: "Select option  ·  Back to return";
                        font-size: 12px;
                        font-weight: 400;
                        color: rgba(246, 241, 231, 0.85);
                    }
                }
            }
        }
    }

    // Remote D-pad event capture
    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.key_up(); accept; }
            else if (event.text == Key.DownArrow) { root.key_down(); accept; }
            else if (event.text == Key.LeftArrow) { root.key_left(); accept; }
            else if (event.text == Key.RightArrow) { root.key_right(); accept; }
            else if (event.text == Key.Return) { root.key_ok(); accept; }
            else if (event.text == Key.Escape || event.text == Key.Back) { root.key_back(); accept; }
            else { reject; }
        }
    }
}
